def charger_traductions() -> dict[str, dict[str, str]]:
    """{code: {source_fr: traduction}} depuis les fichiers trouvés ; fr = source."""
    out: dict[str, dict[str, str]] = {"fr": {}}
    for d in dossiers_langues():
        try:
            noms = sorted(os.listdir(d))
        except OSError:
            continue
        for n in noms:
            if not n.endswith(".json") or n.startswith("_") or n[:-5] in out:
                continue
            try:
                with open(os.path.join(d, n), encoding="utf-8") as f:
                    out[n[:-5]] = json.load(f)
            except (OSError, ValueError):
                continue
    return out


