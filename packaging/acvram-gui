def serveur_acvram(port: int) -> bool:
    try:
        with urllib.request.urlopen(f"http://127.0.0.1:{port}/v1/models", timeout=1) as r:
            return b'"acvram"' in r.read()
    except Exception:
        return False


def trouver_serveur() -> int | None:
    for p in PORTS:
        if serveur_acvram(p):
            return p
    return None


def modeles_du_parc() -> list[tuple[str, str]]:
    """(nom, chemin) pour chaque dossier converti qui porte un manifeste."""
    vus, out = set(), []
    for parc in PARCS_CONNUS:
        for m in sorted(glob.glob(os.path.join(parc, "*", "acvram_manifest.json"))):
            d = os.path.dirname(m)
            if d in vus:
                continue
            vus.add(d)
            taille = 0
            try:
                for f in os.scandir(d):
                    if f.is_file():
                        taille += f.stat().st_size
            except OSError:
                pass
            out.append((f"{os.path.basename(d)}  ({taille / 2**30:.1f} Gio)", d))
    return out


