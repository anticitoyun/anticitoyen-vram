def version_acvram() -> str:
    """Version du paquet : le module s'il est importable (venv, .deb), sinon le
    pyproject.toml du dépôt à côté du script, sinon « ? » — jamais devinée."""
    try:
        from acvram import __version__
        return __version__
    except Exception:
        pass
    import re
    for cand in (os.path.join(os.path.dirname(os.path.realpath(sys.argv[0])), "..", "pyproject.toml"),
                 "/usr/share/acvram/pyproject.toml"):
        try:
            m = re.search(r'^version\s*=\s*"([^"]+)"', open(cand, encoding="utf-8").read(), re.M)
            if m:
                return m.group(1)
        except OSError:
            continue
    return "?"

