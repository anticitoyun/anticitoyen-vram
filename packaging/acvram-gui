def _id_option(flag: str) -> str:
    return "opt_" + flag.lstrip("-").replace("-", "_")


def html_options_convert() -> str:
    """Le bloc repliable « toutes les options » : un champ par entrée de la table."""
    lignes = []
    for flag, genre, aide_val, aide in OPTIONS_CONVERT:
        i = _id_option(flag)
        t = html.escape(T(aide))
        if genre == "bool":
            lignes.append(f'<label title="{t}"><input type="checkbox" id="{i}"> <code>{flag}</code> — {t}</label>')
        elif genre == "choice":
            opts = "".join(f'<option value="{html.escape(v)}">{html.escape(v) or "—"}</option>' for v in aide_val)
            lignes.append(f'<label title="{t}"><code>{flag}</code> <select id="{i}">{opts}</select> — {t}</label>')
        else:
            lignes.append(f'<label title="{t}"><code>{flag}</code> <input type="text" id="{i}" placeholder="{html.escape(aide_val)}" style="width:38%"> — {t}</label>')
    return "<br>\n".join(lignes)


def js_options_convert() -> str:
    """Le fragment JS qui recueille chaque champ dans l'objet envoyé au processus."""
    parts = []
    for flag, genre, _, _ in OPTIONS_CONVERT:
        i = _id_option(flag)
        if genre == "bool":
            parts.append(f"'{flag}':document.getElementById('{i}').checked")
        else:
            parts.append(f"'{flag}':document.getElementById('{i}').value")
    return ",".join(parts)



