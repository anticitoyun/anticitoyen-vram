class Fenetre(Gtk.Window):
    def __init__(self):
        super().__init__(title="acvram")
        l, h = (os.environ.get("ACVRAM_GUI_TAILLE", "1280x860").split("x") + ["860"])[:2]
        self.set_default_size(int(l), int(h))
        self.set_icon_name("acvram")
        self.proc: subprocess.Popen | None = None
        self.port: int | None = None

        boite = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        self.add(boite)

        # Barre d'outils native : ce que la page ne peut pas faire seule.
        barre = Gtk.HeaderBar(show_close_button=True, title="acvram")
        self.set_titlebar(barre)
        self.boutons = []
        # Le logo remplace les boutons zoom (Ctrl +/−/0 restent au clavier).
        chemin_logo = next((c for c in (os.path.join(os.path.dirname(os.path.realpath(sys.argv[0])), "logo-acvram.jpg"),
                                        "/usr/share/acvram/logo-acvram.jpg") if os.path.isfile(c)), None)
        if chemin_logo:
            try:
                from gi.repository import GdkPixbuf
                pb = GdkPixbuf.Pixbuf.new_from_file_at_scale(chemin_logo, -1, 30, True)
                img = Gtk.Image.new_from_pixbuf(pb)
                img.set_tooltip_text("acvram")
                barre.pack_start(img)
            except Exception:
                pass
        for ico, tip, cb in (("view-refresh", "recharger (F5)", self.recharger),
                             ("view-fullscreen", "plein écran (F11)", self.plein_ecran),
                             ("process-stop", "arrêter le serveur lancé ici", self.arreter_serveur)):
            b = Gtk.Button.new_from_icon_name(ico, Gtk.IconSize.BUTTON)
            b.set_tooltip_text(T(tip))
            b.connect("clicked", cb)
            barre.pack_end(b) if ico == "process-stop" else barre.pack_start(b)
            self.boutons.append((b, tip))
        # Langue : menu dans la barre ; le choix est mémorisé et la page
        # d'accueil (native) est regénérée ; la console servie reste telle
        # que le serveur la rend.
        # Thème du logo : quatre propositions, choix mémorisé (~/.config/acvram/theme).
        self.menu_theme = Gtk.MenuButton()
        self.menu_theme.set_tooltip_text(T("Thème"))
        self.menu_theme.set_image(Gtk.Image.new_from_icon_name("preferences-desktop-wallpaper", Gtk.IconSize.BUTTON))
        m = Gtk.Menu()
        for code, libelle in THEMES.items():
            it = Gtk.MenuItem(label=libelle + ("  ✓" if code == THEME else ""))
            it.connect("activate", lambda _w, c=code: self.changer_theme(c))
            m.append(it)
        m.show_all()
        self.menu_theme.set_popup(m)
        barre.pack_end(self.menu_theme)
        self.menu_langue = Gtk.MenuButton()
        self.menu_langue.set_tooltip_text(T("Langue"))
        self.menu_langue.add(Gtk.Label(label=LANGUES[LANGUE]))
        menu = Gtk.Menu()
        for code, nom in sorted(LANGUES.items(), key=lambda kv: (kv[0] != "fr", kv[1].lower())):
            item = Gtk.MenuItem(label=nom)
            item.connect("activate", lambda _i, c=code: self.changer_langue(c))
            menu.append(item)
        menu.show_all()
        self.menu_langue.set_popup(menu)
        barre.pack_end(self.menu_langue)

        self.web = WebKit2.WebView()
        reglages = self.web.get_settings()
        reglages.set_enable_developer_extras(True)
        reglages.set_enable_javascript(True)
        reglages.set_allow_file_access_from_file_urls(True)   # galerie : images en file:// depuis une page file:///
        # Sans ce reglage, une ouverture non declenchee par un geste utilisateur
        # DIRECT (verifie a sec : un clic simule via JS compte comme tel) est
        # refusee silencieusement — un vrai clic humain sur "galerie" passe
        # sans lui, mais le laisser off est un risque non mesure pour rien.
        reglages.set_javascript_can_open_windows_automatically(True)
        # Le pont page → Python : la page d'accueil envoie « lancer ».
        gest = self.web.get_user_content_manager()
        gest.register_script_message_handler("acvram")
        gest.connect("script-message-received::acvram", self.message_page)
        # target="_blank" (le lien « galerie » de la console servie) ne fait
        # rien dans une WebView embarquee sans ce gestionnaire : WebKitGTK ne
        # cree pas de fenetre tout seul pour une navigation « nouvelle vue »,
        # il emet juste ce signal et attend qu'on lui en fournisse une
        # (18/09, signale par l'utilisateur : « galerie ne fait plus rien »).
        self.web.connect("create", self.nouvelle_fenetre)
        boite.pack_start(self.web, True, True, 0)

        self.etat = Gtk.Label(xalign=0)
        self.etat.set_margin_start(10); self.etat.set_margin_end(10)
        self.etat.set_margin_top(3); self.etat.set_margin_bottom(3)
        pied = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        pied.pack_start(self.etat, True, True, 0)
        version = Gtk.Label(xalign=1)
        version.set_markup(f'<span size="small" foreground="#c98fae">acvram {version_acvram()}</span>')
        pied.pack_end(version, False, False, 4)
        soutien = Gtk.LinkButton.new_with_label(SOUTIEN_URL, T("Soutenir"))
        self.b_soutien = soutien
        soutien.set_tooltip_text(SOUTIEN_URL)
        soutien.set_relief(Gtk.ReliefStyle.NONE)
        pied.pack_end(soutien, False, False, 0)
        boite.pack_start(pied, False, False, 0)

        self.connect("key-press-event", self.touche)
        self.connect("destroy", self.fermer)
        GLib.timeout_add_seconds(2, self.rafraichir_etat)

        port = trouver_serveur()
        if port:
            self.ouvrir(port)
        else:
            self.web.load_html(page_accueil(), "file:///")

    # -- langue -------------------------------------------------------------
    def changer_langue(self, code: str):
        global LANGUE
        if code not in LANGUES or code == LANGUE:
            return
        LANGUE = code
        try:
            os.makedirs(os.path.dirname(FICHIER_LANGUE), exist_ok=True)
            with open(FICHIER_LANGUE, "w", encoding="utf-8") as f:
                f.write(code + "\n")
        except OSError:
            pass
        for b, tip in self.boutons:
            b.set_tooltip_text(T(tip))
        self.menu_langue.get_child().set_text(LANGUES[code])
        self.menu_langue.set_tooltip_text(T("Langue"))
        self.b_soutien.set_label(T("Soutenir"))
        if self.port is None and self.proc is None:
            self.web.load_html(page_accueil(), "file:///")

    # -- navigation ---------------------------------------------------------
    def ouvrir(self, port: int):
        self.port = port
        self.web.load_uri(f"http://127.0.0.1:{port}/")

    def recharger(self, *_):
        self.web.reload()

    def plein_ecran(self, *_):
        if getattr(self, "_fs", False):
            self.unfullscreen(); self._fs = False
        else:
            self.fullscreen(); self._fs = True

    def changer_theme(self, code: str):
        changer_theme(code)
        m = Gtk.Menu()
        for c, libelle in THEMES.items():
            it = Gtk.MenuItem(label=libelle + ("  ✓" if c == THEME else ""))
            it.connect("activate", lambda _w, cc=c: self.changer_theme(cc))
            m.append(it)
        m.show_all()
        self.menu_theme.set_popup(m)
        # La page d'accueil est native : on la regénère (reload() rejouerait le
        # même HTML) ; la console servie reste telle quelle.
        if self.port is None and self.proc is None:
            self.web.load_html(page_accueil(), "file:///")

    def zoom(self, d: float):
        self.web.set_zoom_level(max(0.5, min(3.0, self.web.get_zoom_level() + d)))

    def nouvelle_fenetre(self, web_view, navigation_action):
        """Fournit la fenetre qu'une navigation target="_blank" (ou
        window.open) demande — sans ca WebKitGTK n'ouvre rien du tout.
        Une adresse externe (le lien de soutien) part dans le navigateur
        du systeme : une page publique n'a rien a faire dans la console."""
        try:
            uri = navigation_action.get_request().get_uri()
        except Exception:
            uri = ""
        if uri.startswith("http") and "127.0.0.1" not in uri and "localhost" not in uri:
            from gi.repository import Gdk
            Gtk.show_uri_on_window(self, uri, Gdk.CURRENT_TIME)
            return None
        nouvelle = WebKit2.WebView.new_with_related_view(web_view)
        fenetre = Gtk.Window(title="acvram")
        fenetre.set_default_size(1100, 800)
        fenetre.add(nouvelle)
        nouvelle.connect("ready-to-show", lambda w: fenetre.show_all())
        return nouvelle

    def touche(self, _w, ev):
        from gi.repository import Gdk
        k = Gdk.keyval_name(ev.keyval)
        ctrl = ev.state & Gdk.ModifierType.CONTROL_MASK
        if k == "F5": self.recharger()
        elif k == "F11": self.plein_ecran()
        elif ctrl and k in ("plus", "equal", "KP_Add"): self.zoom(0.1)
        elif ctrl and k in ("minus", "KP_Subtract"): self.zoom(-0.1)
        elif ctrl and k == "0": self.web.set_zoom_level(1.0)
        elif ctrl and k == "q": self.close()
        else: return False
        return True

    # -- serveur ------------------------------------------------------------
    def message_page(self, _gest, res):
        try:
            d = json.loads(res.get_js_value().to_string())
        except Exception:
            return
        if d.get("action") == "lancer":
            self.lancer_serveur(d)
        elif d.get("action") == "connecter":
            self.connecter_existant(d)
        elif d.get("action") == "convertir":
            self.lancer_conversion(d)
        elif d.get("action") == "proposer":
            self.proposer_conversion(d)
        elif d.get("action") == "eco":
            self.changer_eco(d)

    def connecter_existant(self, d: dict):
        try:
            port = int(d["port"])
        except (KeyError, ValueError):
            self.web.load_html(page_accueil(T("port invalide.")), "file:///")
            return
        if serveur_acvram(port):
            self.ouvrir(port)
        else:
            self.web.load_html(page_accueil(T(
                "aucun serveur acvram ne répond sur le port {port} (vérifié : /v1/models doit porter le champ « acvram »).",
                port=port)), "file:///")

    def lancer_serveur(self, d: dict):
        modele = d["modele"]
        env = dict(os.environ)
        if d.get("carte", "") != "":
            env["CUDA_VISIBLE_DEVICES"] = str(d["carte"])
            env["ACVRAM_VERROU"] = f"/tmp/acvram-carte-{d['carte']}.lock"
        env["ACVRAM_NOM"] = "acvram-gui"
        env["ACVRAM_TYPE"] = "mesure"
        if not d.get("graphes", True):
            env["ACVRAM_GRAPHS"] = "0"
        cmd = ["acvram", "serve", modele, "--port", str(PORT_DEFAUT),
               "--max-slots", str(d.get("slots", 4)),
               "--max-model-len", str(d.get("ctx", 8192))]
        carte_sh = os.path.join(os.path.dirname(os.path.realpath(sys.argv[0])), "..", "share", "acvram", "carte.sh")
        for cand in (carte_sh, "outils/carte.sh", "/usr/share/acvram/carte.sh"):
            if os.path.exists(cand):
                cmd = ["bash", cand] + cmd
                break
        self.web.load_html(page_attente(modele), "file:///")
        try:
            self.proc = subprocess.Popen(cmd, env=env, stdout=subprocess.PIPE,
                                         stderr=subprocess.STDOUT, text=True,
                                         start_new_session=True)
        except OSError as e:
            self.web.load_html(page_accueil(T("impossible de lancer acvram : {e}", e=e)), "file:///")
            return
        threading.Thread(target=self.suivre_journal, daemon=True).start()
        GLib.timeout_add_seconds(2, self.attendre_serveur)

    def suivre_journal(self):
        assert self.proc and self.proc.stdout
        for ligne in self.proc.stdout:
            l = json.dumps(ligne.rstrip())
            GLib.idle_add(self.web.run_javascript,
                          f"(function(){{var p=document.getElementById('log');if(p){{p.textContent+={l}+'\\n';p.scrollTop=p.scrollHeight;}}}})()",
                          None, None, None)

    def attendre_serveur(self) -> bool:
        if self.proc and self.proc.poll() is not None:
            self.web.load_html(page_accueil(T(
                "le serveur s'est arrêté (code {code}) — voir le journal ci-dessus", code=self.proc.returncode)), "file:///")
            self.proc = None
            return False
        if serveur_acvram(PORT_DEFAUT):
            self.ouvrir(PORT_DEFAUT)
            return False
        return True

    def changer_eco(self, d: dict):
        """`acvram eco <mode>` écrit config.json puis applique (même sous un serveur)."""
        mode = str(d.get("mode", ""))
        if mode not in ("2700", "2100", "off"):
            return

        def travail():
            try:
                out = subprocess.run(["acvram", "eco", mode], capture_output=True, text=True, timeout=15)
                msg = (out.stdout + out.stderr).strip().splitlines()
                texte = msg[-1] if msg else ""
                if out.returncode != 0:
                    texte = T("acvram eco {mode} a échoué (code {code}) : {texte}", mode=mode, code=out.returncode, texte=texte)
            except Exception as e:
                texte = T("acvram eco {mode} a échoué (code {code}) : {texte}", mode=mode, code="?", texte=e)
            etat = etat_eco_carte() or texte
            GLib.idle_add(self.web.run_javascript,
                          f"(function(){{var e=document.getElementById('eco_etat');if(e)e.textContent={json.dumps(etat)};}})()", None, None, None)
        threading.Thread(target=travail, daemon=True).start()

    def proposer_conversion(self, d: dict):
        source = d.get("source", "")
        if not os.path.isdir(source):
            self.web.run_javascript(f"appliquerProposition({{}}, {json.dumps(T('répertoire source introuvable : {source}', source=source))})", None, None, None)
            return

        def travail():
            props, resume = proposer_options_convert(source)
            GLib.idle_add(self.web.run_javascript,
                          f"appliquerProposition({json.dumps(props)}, {json.dumps(resume)})", None, None, None)
        threading.Thread(target=travail, daemon=True).start()

    def lancer_conversion(self, d: dict):
        source = d.get("source", "")
        if not os.path.isdir(source):
            self.web.load_html(page_accueil(T("répertoire source introuvable : {source}", source=source)), "file:///")
            return
        cmd = ["acvram", "convert", source]
        if d.get("nom"):
            cmd += ["--name", d["nom"]]
        if d.get("essai"):
            cmd += ["--dry-run"]
        options = d.get("options") or {}
        for flag, genre, _, _ in OPTIONS_CONVERT:
            v = options.get(flag)
            if genre == "bool":
                if v:
                    cmd.append(flag)
            elif v not in (None, ""):
                cmd += [flag, str(v).strip()]
        self.web.load_html(page_conversion(source), "file:///")
        try:
            self.proc = subprocess.Popen(cmd, env=dict(os.environ), stdout=subprocess.PIPE,
                                         stderr=subprocess.STDOUT, text=True,
                                         start_new_session=True)
        except OSError as e:
            self.web.load_html(page_accueil(T("impossible de lancer acvram convert : {e}", e=e)), "file:///")
            return
        threading.Thread(target=self.suivre_journal, daemon=True).start()
        GLib.timeout_add_seconds(2, self.attendre_conversion)

    def attendre_conversion(self) -> bool:
        if self.proc is None or self.proc.poll() is None:
            return True
        code = self.proc.returncode
        self.proc = None
        if code == 0:
            self.web.load_html(page_accueil(T("conversion terminée — voir models_acvram.")), "file:///")
        else:
            self.web.load_html(page_accueil(T("acvram convert a échoué (code {code}) — voir le journal ci-dessus.", code=code)), "file:///")
        return False

    def arreter_serveur(self, *_):
        if self.proc and self.proc.poll() is None:
            os.killpg(self.proc.pid, signal.SIGTERM)
            try:
                self.proc.wait(timeout=15)
            except subprocess.TimeoutExpired:
                os.killpg(self.proc.pid, signal.SIGKILL)
        self.proc = None
        self.port = None
        self.web.load_html(page_accueil(T("serveur arrêté.")), "file:///")

    # -- barre d'état -------------------------------------------------------
    def rafraichir_etat(self) -> bool:
        parts = []
        try:
            out = subprocess.run(["nvidia-smi", "--query-gpu=index,temperature.gpu,power.draw,utilization.gpu,memory.used,memory.total",
                                  "--format=csv,noheader,nounits"], capture_output=True, text=True, timeout=2).stdout
            for l in out.strip().splitlines():
                i, t, w, u, m, mt = [x.strip() for x in l.split(",")]
                parts.append(f"GPU{i} {t} °C · {float(w):.0f} W · {u} % · {float(m)/1024:.1f}/{float(mt)/1024:.0f} Gio")
        except Exception:
            pass
        try:
            import psutil
            vm = psutil.virtual_memory()
            parts.append(f"CPU {psutil.cpu_percent():.0f} % · RAM {(vm.total-vm.available)/2**30:.1f}/{vm.total/2**30:.0f} Gio")
            temps = psutil.sensors_temperatures()
            for cle in ("coretemp", "k10temp"):
                if cle in temps and temps[cle]:
                    parts.append(f"CPU {temps[cle][0].current:.0f} °C")
                    break
        except Exception:
            pass
        if self.port:
            parts.append(T("serveur :{port}", port=self.port))
        self.etat.set_markup('<span size="small" foreground="#c98fae">' + "   ·   ".join(parts) + "</span>")
        return True

    def fermer(self, *_):
        self.arreter_serveur() if self.proc else None
        Gtk.main_quit()


def main():
    f = Fenetre()
    f.show_all()
    signal.signal(signal.SIGINT, lambda *_: Gtk.main_quit())
    Gtk.main()


if __name__ == "__main__":
    main()
