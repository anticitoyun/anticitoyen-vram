def T(s: str, **kw) -> str:
    """Traduction de la langue courante, source française sinon ; les {clés}
    sont remplies après traduction, pour que l'ordre des mots reste libre."""
    r = TRADUCTIONS.get(LANGUE, {}).get(s) or s
    return r.format(**kw) if kw else r


def svg_schema_openwebui() -> str:
    """Schéma inline (SVG, pas une capture d'écran de la machine) : navigateur → Open WebUI (3000) → acvram (port
    servi) → modèle sur la carte ; les libellés passent par T() comme le reste de l'onglet."""
    b, w, a, m = T("Navigateur"), "Open WebUI", "acvram", T("modèle (carte)")
    port = PORT_DEFAUT
    def boite(x, titre, sous):
        return (f'<rect x="{x}" y="22" width="150" height="56" rx="10" fill="var(--carte)" stroke="var(--rose-vif)" stroke-width="1.5"/>'
                f'<text x="{x + 75}" y="46" text-anchor="middle" font-size="13" font-weight="600" fill="var(--texte)">{titre}</text>'
                f'<text x="{x + 75}" y="66" text-anchor="middle" font-size="11" fill="var(--texte-2)">{sous}</text>')
    def fleche(x1, x2, etiquette):
        return (f'<line x1="{x1}" y1="50" x2="{x2}" y2="50" stroke="var(--rose-vif)" stroke-width="1.5" marker-end="url(#f)"/>'
                f'<text x="{(x1 + x2) // 2}" y="42" text-anchor="middle" font-size="10" fill="var(--texte-2)">{etiquette}</text>')
    return ('<svg viewBox="0 0 700 100" width="100%" style="max-width:700px;display:block;margin:8px 0" role="img" '
            f'aria-label="{b} → Open WebUI → acvram → {m}">'
            '<defs><marker id="f" markerWidth="8" markerHeight="8" refX="7" refY="4" orient="auto">'
            '<path d="M0,0 L8,4 L0,8 z" fill="var(--rose-vif)"/></marker></defs>'
            + boite(10, b, "http://127.0.0.1:3000") + fleche(160, 194, "HTTP")
            + boite(196, w, T("Réglages → Connexions → OpenAI")) + fleche(346, 380, f"/v1 · {T('clé')} acvram-local")
            + boite(382, a, f"http://127.0.0.1:{port}/v1") + fleche(532, 566, T("jetons + image"))
            + boite(568, m, "acvram/acvram 👁") + '</svg>')


