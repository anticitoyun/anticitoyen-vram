def _racine_configuree() -> list[str]:
    """La même lecture que outils/racine_modeles.py (hors paquet) : ACVRAM_MODELES, ACVRAM_MODELS_DIR, puis
    ~/.config/acvram/modeles (première ligne non commentée qui existe) — aucun chemin de machine dans le paquet."""
    for v in ("ACVRAM_MODELES", "ACVRAM_MODELS_DIR"):
        if os.environ.get(v):
            return [os.environ[v]]
    conf = os.path.join(os.environ.get("XDG_CONFIG_HOME", os.path.expanduser("~/.config")), "acvram", "modeles")
    try:
        with open(conf, encoding="utf-8") as f:
            return [l.strip() for l in f if l.strip() and not l.startswith("#") and os.path.isdir(l.strip())][:1]
    except OSError:
        return []


