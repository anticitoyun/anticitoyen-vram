#!/usr/bin/env bash
# acvram-serveur — sert un modèle converti acvram sur http://127.0.0.1:8090/v1.
# Usage : acvram-serveur <alias|dossier-converti> [contexte]
#   Un alias est résolu par ~/.kimi-code/acvram-chemins.tsv ; si le modèle
#   demandé est déjà servi, le serveur en place est réutilisé tel quel.
# Moteur : ~/Bureau/Claude/anticitoyen-vram (NVFP4 sur la 5090, INT4 sur la
# 3080 Ti, graphes CUDA au décodage). Journal : /tmp/acvram-serveur.log
set -euo pipefail
TSV="$HOME/TSV/acvram-chemins.tsv"
PORT=${PARC_PORT_ACVRAM:-8090}   # le port que les menus interrogent (claude-modele, kimi-modele)
err() { printf '\033[31m%s\033[0m\n' "$*" >&2; }

[ $# -ge 1 ] || { err "Usage : acvram-serveur <alias|dossier> [contexte]"; exit 1; }
CIBLE="$1"; CTX="${2:-${CTX:-}}"   # $2 prime, sinon la variable d'environnement (le banc la passe ainsi)

if [ ! -d "$CIBLE" ]; then
    ligne=$(grep "^$CIBLE	" "$TSV" 2>/dev/null | head -1) \
        || { err "Alias absent de $TSV : $CIBLE"; exit 1; }
    dossier=$(printf '%s' "$ligne" | cut -f2)
    [ -n "$CTX" ] || CTX=$(printf '%s' "$ligne" | cut -f3)
    ctx_client_min_col4=$(printf '%s' "$ligne" | cut -f4)   # surcharge admin (col4 TSV)
    alias_nom="$CIBLE"
else
    dossier="$CIBLE"
    alias_nom=$(basename "$CIBLE")
    ctx_client_min_col4=""
fi
[ -d "$dossier" ] || { err "Dossier introuvable : $dossier"; exit 1; }
dossier=$(readlink -f "$dossier")   # absolu : le service part d'un cwd neutre (plus bas)
CTX="${CTX:-32768}"
_ici=$(dirname "$(readlink -f "$0")")

# Epinglage par defaut, comme llamacpp-serveur (l.77) et vllm-serveur (l.225).
# acvram etait le SEUL des trois a laisser les deux cartes visibles : le
# planificateur recrutait alors la 3080 Ti (_replanifier, loader.py:1132), et
# nos mesures portaient un attelage 5090+3080 Ti quand celles des concurrents
# portaient la 5090 seule. Une surcharge explicite reste possible.
# AVANT la garde VRAM (t5e, 27/09) : posée après, la garde lisait une variable non
# définie — `set -u` tuait le lanceur (rc 1) dans tout environnement de bureau.
: "${CUDA_VISIBLE_DEVICES:=0}"; : "${CUDA_DEVICE_ORDER:=PCI_BUS_ID}"
[ -n "$CUDA_VISIBLE_DEVICES" ] || CUDA_VISIBLE_DEVICES=0
export CUDA_VISIBLE_DEVICES CUDA_DEVICE_ORDER

# CARTE RENDUE (kwh, edz 30/09 00:48 : 10 OOM en 3 min au changement de modèle) : un serveur mort n'a pas encore
# rendu sa VRAM. Garde partagée des trois lanceurs, parc/lib/carte_rendue.py (le pourquoi y est) ; $1 = PID remplacé.
_carte_rendue=${PARC_CARTE_RENDUE:-$(dirname "$(readlink -f "$0")")/../lib/carte_rendue.py}
[ -f "$_carte_rendue" ] || _carte_rendue=/usr/share/acvram-parc/lib/carte_rendue.py
attendre_carte_rendue() {
    [ -f "$_carte_rendue" ] || { err "avertissement : $_carte_rendue introuvable — démarrage sans attendre la carte"; return 0; }
    python3 "$_carte_rendue" --nom acvram --cartes "$CUDA_VISIBLE_DEVICES" ${1:+--remplace "$1"} || exit 1
}

# déjà servi ? (avant la garde : le modèle en place occupe la VRAM qu'elle compte)
servi=$(curl -s -m 2 "http://127.0.0.1:$PORT/v1/models" 2>/dev/null \
    | python3 -c 'import json,sys;print(json.load(sys.stdin)["data"][0]["id"])' \
    2>/dev/null || true)
[ "$servi" = "$alias_nom" ] && { echo "acvram sert déjà $alias_nom"; exit 0; }
# serveur à remplacer : sa VRAM sera rendue, la garde la compte comme libre
pid=$(ss -tlnp 2>/dev/null | grep ":$PORT " | grep -oP 'pid=\K[0-9]+' | head -1 || true)

# ctx_client_min : le menu exporte CTX_CLIENT_MIN (besoin structurel du client) ;
# la col4 TSV est une surcharge admin qui prime sur la valeur du menu.
ctx_client_min="${ctx_client_min_col4:-${CTX_CLIENT_MIN:-}}"

# Si le client exige plus de contexte que CTX, tenter d'adapter ou refuser
if [ -n "$ctx_client_min" ] && [ "$ctx_client_min" -gt "${CTX:-0}" ] 2>/dev/null; then
    ctx_max_modele=$(python3 -c "
import json, pathlib, sys
cfg = pathlib.Path('$dossier') / 'config.json'
if cfg.exists():
    d = json.loads(cfg.read_text())
    # config multimodale (Gemma 4 vision, Qwen-VL…) : la limite du texte est sous text_config (edz 28/09 : lue à 0)
    for sous in (d, d.get('text_config') or {}, d.get('llm_config') or {}, d.get('language_config') or {}):
        if sous.get('max_position_embeddings'):
            print(sous['max_position_embeddings']); break
    else:
        print(0)
else:
    print(0)
" 2>/dev/null || echo 0)
    if [ "$ctx_client_min" -le "$ctx_max_modele" ] 2>/dev/null; then
        echo "acvram : ctx ajusté $CTX → $ctx_client_min (ctx_client_min=$ctx_client_min, modèle supporte jusqu'à $ctx_max_modele)"
        CTX="$ctx_client_min"
    else
        err "Alias refusé : client requiert ctx≥$ctx_client_min, modèle limité à $ctx_max_modele (ctx demandé=$CTX)"
        exit 1
    fi
fi

# avant la garde : un serveur arrêté par un autre (menu, harnais) peut encore tenir la VRAM qu'elle compte
attendre_carte_rendue ""

# Garde VRAM : KV cache estimé pour CTX vs VRAM libre sur la carte sélectionnée.
# Formule fp16 : 2 (K+V) × couches × têtes_kv × dim_tête × ctx × 2 octets.
# N'est un refus dur que si on peut lire la config ; sinon on passe (garde souple).
_vram_verdict=$(python3 - <<PYEOF 2>/dev/null
import json, pathlib, subprocess, sys
cfg = pathlib.Path('$dossier') / 'config.json'
if not cfg.exists():
    sys.exit(0)
try:
    d = json.loads(cfg.read_text())
    nl  = d.get('num_hidden_layers', 0)
    nkv = d.get('num_key_value_heads', d.get('num_attention_heads', 0))
    ha  = d.get('num_attention_heads', 1)
    hs  = d.get('hidden_size', 0)
    hd  = d.get('head_dim', hs // ha if ha else 0)
    ctx = int('$CTX')
    if not (nl and nkv and hd):
        sys.exit(0)
    kv_bytes = 2 * nl * nkv * hd * ctx * 2   # fp16
    gpu_id = '$CUDA_VISIBLE_DEVICES'.split(',')[0]
    out = subprocess.check_output(
        ['nvidia-smi', f'--id={gpu_id}', '--query-gpu=memory.free',
         '--format=csv,noheader,nounits'],
        text=True, stderr=subprocess.DEVNULL)
    free_mib = int(out.strip().split('\n')[0])
    if '$pid':
        apps = subprocess.check_output(
            ['nvidia-smi', f'--id={gpu_id}', '--query-compute-apps=pid,used_memory',
             '--format=csv,noheader,nounits'], text=True, stderr=subprocess.DEVNULL)
        free_mib += sum(int(m) for p, m in (l.split(',') for l in apps.strip().split('\n') if ',' in l)
                        if p.strip() == '$pid')
    free_bytes = free_mib * 1024 * 1024
    kv_gib   = kv_bytes   / (1024**3)
    free_gib = free_bytes / (1024**3)
    if kv_bytes > free_bytes:
        print(f'KV estimé {kv_gib:.1f} Gio (ctx={ctx}), VRAM libre {free_gib:.1f} Gio — insuffisant')
except FileNotFoundError:
    print('INFO:nvidia-smi introuvable — garde VRAM inactive')
except Exception:
    pass
PYEOF
)
case "$_vram_verdict" in
    INFO:*) echo "acvram : ${_vram_verdict#INFO:}" ;;
    "") ;;
    *) err "Alias refusé : $_vram_verdict"; exit 1 ;;
esac

# remplacer le serveur en place — pièce ECONNREFUSED (5xw) : l'arrêt est signé dans le journal des arrêts
if [ -n "$pid" ]; then
    _j="${ACVRAM_JOURNAL_ARRETS:-$HOME/.cache/acvram/arrets.journal}"; mkdir -p "$(dirname "$_j")" 2>/dev/null || true
    printf '%s\t%s\tSIGTERM\t%s\t%s\n' "$(date +%FT%T)" "$pid" "$(tr '\0' ' ' < "/proc/$pid/cmdline" 2>/dev/null | cut -c1-160)" \
        "acvram-serveur : remplacé par $alias_nom (servait ${servi:-?}) session=${ACVRAM_SESSION:-?} poste=${ACVRAM_POSTE:-?}" >> "$_j" 2>/dev/null || true
    kill "$pid" 2>/dev/null || true
    # « sleep 4 » ne prouvait rien : on attend la mort (zombie compris), SIGKILL signé au-delà du délai
    for _ in $(seq 1 "${ACVRAM_DELAI_TERM:-30}"); do
        grep -qE '^[0-9]+ \(.*\) [ZX] ' "/proc/$pid/stat" 2>/dev/null || [ ! -e "/proc/$pid" ] && break
        sleep 1
    done
    if [ -e "/proc/$pid" ] && ! grep -qE '^[0-9]+ \(.*\) [ZX] ' "/proc/$pid/stat" 2>/dev/null; then
        printf '%s\t%s\tSIGKILL\t%s\t%s\n' "$(date +%FT%T)" "$pid" "$(tr '\0' ' ' < "/proc/$pid/cmdline" 2>/dev/null | cut -c1-160)" \
            "acvram-serveur : SIGTERM sans effet en ${ACVRAM_DELAI_TERM:-30} s" >> "$_j" 2>/dev/null || true
        kill -KILL "$pid" 2>/dev/null || true
    fi
    attendre_carte_rendue "$pid"
fi

# Rien de ce qui decide du placement ou du regime ne doit etre choisi en
# silence : ces trois valeurs changent ce qui est mesure.
echo "acvram : service de $alias_nom (contexte $CTX)…"
echo "acvram : cartes=$CUDA_VISIBLE_DEVICES  speculation=${SPECULATIF:-ngram}  plan_fige=${ACVRAM_PLAN_FIGE:-0}"
# Source du code servi (poste7-3b-lanceur-contexte-20-09) : le PAQUET installé par défaut ;
# ACVRAM_ARBRE=<chemin du dépôt> = opt-in vers l'arbre de dev (son venv). La ligne « source= »
# dit lequel, parce que « même code » entre l'arbre et le .deb est faux tant qu'un diff existe.
if [ -n "${ACVRAM_ARBRE:-}" ]; then
    [ -x "$ACVRAM_ARBRE/.venv/bin/acvram" ] || { err "ACVRAM_ARBRE=$ACVRAM_ARBRE : pas de .venv/bin/acvram"; exit 1; }
    sha=$(git -C "$ACVRAM_ARBRE" rev-parse --short HEAD 2>/dev/null || echo inconnu)
    br=$(git -C "$ACVRAM_ARBRE" rev-parse --abbrev-ref HEAD 2>/dev/null || echo inconnu)
    etat=$([ -z "$(git -C "$ACVRAM_ARBRE" status --porcelain -- acvram 2>/dev/null)" ] && echo propre || echo sale)
    ACVRAM_BIN="$ACVRAM_ARBRE/.venv/bin/acvram"
    SOURCE="arbre($br@$sha,$etat)"
else
    ACVRAM_BIN=${ACVRAM_PAQUET_BIN:-/usr/bin/acvram}
    [ -x "$ACVRAM_BIN" ] || { err "paquet acvram absent ($ACVRAM_BIN) : sudo apt install ./acvram_<version>_amd64.deb, ou ACVRAM_ARBRE=<dépôt>"; exit 1; }
    # cwd neutre : lancé depuis un arbre acvram, le paquet refuse l'import (garde d'arbre 276 f) — --version
    # rendait 1 et `set -e` tuait le lanceur sans un mot (t5e, 27/09) ; le service hérite du même cwd.
    cd /
    # 01/10 (rafale e50.2) : carte.sh pose ACVRAM_ARBRE par défaut (bd jdp) et l'exporte au service ; le paquet
    # n'est aucun arbre, sa garde d'import refusait donc tout lancement. Contournement nommé, au point de décision.
    export ACVRAM_ARBRE_LIBRE=1
    # 1re ligne seule : --version imprime aussi la mention de soutien, qui coupait « source= » en deux
    SOURCE="paquet($("$ACVRAM_BIN" --version 2>/dev/null | awk 'NR==1{print $NF}'))"
fi
echo "acvram : source=$SOURCE"
# UN SEUL constructeur : la ligne imprimée est, octet pour octet, celle que l'exec reçoit
# (poste7 21/09 : l'ancien « à sec » omettait --speculative et --no-cuda-graphs). Test :
# ACVRAM_EXEC=<programme> reçoit le tableau au premier plan à la place de setsid nohup.
commande_serve() {
    CMD=("$ACVRAM_BIN" serve "$dossier" --port "$PORT" --served-name "$alias_nom" --max-model-len "$CTX"
         --speculative "${SPECULATIF:-ngram}")
    [ -n "${GRAPHES:-}" ] && CMD+=(--no-cuda-graphs)
    return 0
}
commande_serve
printf 'commande :'; printf ' %q' "${CMD[@]}"; printf '\n'
[ "${ACVRAM_SERVEUR_A_SEC:-0}" = 1 ] && exit 0
if [ -n "${ACVRAM_EXEC:-}" ]; then exec "$ACVRAM_EXEC" "${CMD[@]}"; fi
# Le serveur PREND LE VERROU carte.sh (mode service) : sinon une mesure le croit
# libre (trou du 21/09, REGLES § 2). carte.sh detache le serveur en lui faisant
# heriter le verrou (vivant tant que le serveur vit) et rend le PID. Repli sans
# verrou si carte.sh est introuvable (paquet installe hors depot) — avec un
# avertissement, jamais en silence.
CARTE_SH=${ACVRAM_CARTE_SH:-$_ici/../../outils/carte.sh}
# journal ouvert en ajout : la cause d une mort se lit dans CE lancement seulement (edz 28/09 : une ligne d un
# lancement précédent pouvait être citée)
LOG=${ACVRAM_SERVEUR_LOG:-/tmp/acvram-serveur.log}
debut_log=$(stat -c %s "$LOG" 2>/dev/null || echo 0)
if [ -x "$CARTE_SH" ]; then
    srv_pid=$(ACVRAM_TYPE=service ACVRAM_NOM="$alias_nom" ACVRAM_SERVICE_LOG="$LOG" \
              ACVRAM_CARTE="${ACVRAM_CARTE:-$CUDA_VISIBLE_DEVICES}" \
              "$CARTE_SH" "${CMD[@]}") \
        || { err "carte.sh a refuse le verrou de la carte (voir ci-dessus)"; exit 1; }
else
    err "avertissement : carte.sh introuvable ($CARTE_SH) — serveur lance SANS verrou carte"
    setsid nohup "${CMD[@]}" >> "$LOG" 2>&1 < /dev/null &
    srv_pid=$!
fi

# Délai en secondes d'horloge, pas en tours : 120 tours de 2 s coupaient à 241 s des démarrages VIVANTS (edz
# définitif 30/09, pps : 15 alias GLM-4.7-Flash / 32B à 32 768, chauffe 93-138 s + capture des graphes + recapture ;
# 4 journaux finissent sur « Uvicorn running » juste après la coupure ; le plus long servi : 238 s).
DELAI=${ACVRAM_DELAI_DEMARRAGE:-480}
neuf_du_lancement() {
    tail -c +$(( debut_log + 1 )) "$LOG" 2>/dev/null | grep -vE 'CUDACachingAllocator|gardée|^[[:space:]]*$' || true
}
SECONDS=0   # depuis le lancement du serveur, pas du lanceur (attente kwh de la carte exclue)
while [ "$SECONDS" -lt "$DELAI" ]; do
    curl -s -m 2 "http://127.0.0.1:$PORT/v1/models" >/dev/null 2>&1 \
        && { echo "acvram prêt sur 127.0.0.1:$PORT ($alias_nom)"; exit 0; }
    # mort au démarrage (refus de budget KV, OOM, contexte non tenu) : le dire tout de suite, pas après le délai
    # (t5e 27/09 : devstral à 65 536 refusé en quelques secondes, le menu attendait 4 min)
    if [ -n "${srv_pid:-}" ] && ! kill -0 "$srv_pid" 2>/dev/null; then
        # la cause, pas un avertissement : « disposition Marlin refusée … pile naturelle gardée » n est pas fatale
        # (edz 28/09, gemma 12B bf16 : seule ligne citée, la vraie cause perdue) ; « introuvable : [Errno 2] … manifest »
        # ne contient pas « Error » (pps : gemma-4-12b-it-bf16, dossier non converti, cause perdue derrière « chargement »)
        neuf=$(neuf_du_lancement)
        cause=$(grep -E 'Error|Errno|Exception|introuvable|non tenu|refus :|Killed' <<< "$neuf" | tail -1 || true)
        # kv31b (30/09) : le moteur dit la fenêtre qui TIENT (« [acvram] fenêtre qui tient : N jetons », loader
        # `_fenetre_qui_tient`). Si le client l'accepte (CTX_CLIENT_MIN / col4 : claude 29 120, kimi 34 816) on relance
        # UNE fois à N ; sinon refus nommé avec les deux chiffres — plus « réduire max_model_len » sans dire à combien.
        tient=$(grep -oE '^\[acvram\] fenêtre qui tient : [0-9]+' <<< "$neuf" | tail -1 | grep -oE '[0-9]+$' || true)
        if [ -n "$tient" ] && grep -q 'budget KV insuffisant' <<< "$cause"; then
            if [ "$tient" -ge 1024 ] && [ -z "${ACVRAM_FENETRE_RELANCEE:-}" ] \
               && { [ -z "$ctx_client_min" ] || [ "$tient" -ge "$ctx_client_min" ]; }; then
                echo "acvram : fenêtre $CTX non tenue par la carte (budget KV) — relance à $tient jetons (fenêtre qui tient)"
                ACVRAM_FENETRE_RELANCEE=1 exec "$0" "$CIBLE" "$tient"
            fi
            err "Alias refusé : fenêtre qui tient $tient jetons${ctx_client_min:+ < ctx≥$ctx_client_min requis par le client} (fenêtre demandée $CTX ; $(printf '%s' "$cause" | cut -c1-160))"
            exit 1
        fi
        err "acvram mort au démarrage : $(printf '%s' "${cause:-$(tail -1 <<< "$neuf")}" | cut -c1-240) (journal : $LOG)"
        exit 1
    fi
    sleep 2
done
# vivant mais pas prêt : dire depuis quand et où il en est (la dernière ligne du moteur POUR CE lancement), et que
# le serveur tourne encore — il tient la carte ; l'arrêter reste à l'appelant (menu, harnais), comme avant
err "acvram pas prêt en ${SECONDS} s (ACVRAM_DELAI_DEMARRAGE=$DELAI), serveur vivant${srv_pid:+ (PID $srv_pid)} — dernière étape : $(neuf_du_lancement | tail -1 | cut -c1-200) (journal : $LOG)"
exit 1
