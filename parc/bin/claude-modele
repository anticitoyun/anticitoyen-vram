#!/usr/bin/env bash
# claude-modele — Claude Code sur n'importe quel modèle du parc local, avec le même menu
# et les mêmes fichiers que kimi-modele (~/.kimi-code/config.toml, gguf-chemins.tsv,
# vllm-chemins.tsv, notes-modeles.tsv). Le moteur choisi est démarré si besoin, puis
# claude est lancé sur son API Anthropic (/v1/messages : llama.cpp, appoint, vLLM).
# TabbyAPI n'expose pas cette API : non utilisable ici.
# Usage : claude-modele [alias] [args de claude]
set -uo pipefail
# Seuils de fenêtre — UNE SEULE SOURCE, lue aussi par la GUI claude-modeles via `claude-modele --seuils` (ph1, poste6 30/09 :
# une copie « seuil_minimum 15 096 » dans la GUI avait survécu au passage du lanceur à 29 120 ; entre les deux, la GUI
# lançait puis le lanceur refusait). SEUIL_COMPLET : sous cette fenêtre, jeu d'outils « essentiel » (mode_outils) ;
# PROMPT_BASE_ESSENTIEL : invite estimée de ce jeu ; MIN_REPONSE : réponse minimale exigée avant l'essai à blanc.
# Compaction de claude 2.1.284 (menus, poste6 29/09, revue/poste6-menus-verdict-29-09.md) : TAMPON_COMPACTION (résumé),
# SORTIE_MIN/SORTIE_MAX, MARGE_CONVERSATION — à relire à chaque version de claude (strings, « Auto-compact window »).
# FENETRE_MIN : ce que sortie_pour exige de l'invite essentielle estimée (29 120) — le CTX_CLIENT_MIN demandé à acvram-serveur
# et le seuil de refus affiché par la GUI.
SEUIL_COMPLET=45000; PROMPT_BASE_ESSENTIEL=11000; MIN_REPONSE=4096
TAMPON_COMPACTION=13000; SORTIE_MIN=1024; SORTIE_MAX=8192; MARGE_CONVERSATION=4096
FENETRE_MIN=$(( PROMPT_BASE_ESSENTIEL + TAMPON_COMPACTION + MARGE_CONVERSATION + SORTIE_MIN ))
# --seuils : imprime les seuils et sort AVANT de charger le parc (aucun python, aucun parc.toml : la GUI le joue au démarrage)
if [ "${1:-}" = "--seuils" ]; then printf 'seuil_complet=%s\nseuil_minimum=%s\n' "$SEUIL_COMPLET" "$FENETRE_MIN"; exit 0; fi
# parc.toml (acvram-parc) : chemins, ports, clés et moteurs du poste ; rien n'est codé ici
PARC_LIB_PY=/usr/share/acvram-parc/lib/acvram_parc.py
_ici=$(dirname "$(readlink -f "$0")"); [ -f "$_ici/../lib/acvram_parc.py" ] && PARC_LIB_PY="$_ici/../lib/acvram_parc.py"
set -a; eval "$(python3 "$PARC_LIB_PY" --env)"; set +a
read -r PARC_BIN PARC_TOKENS_TABBY < <(python3 -c "import sys; sys.path.insert(0, '$(dirname "$PARC_LIB_PY")'); from acvram_parc import charger; P = charger(); print(P.bin, P.moteurs.get('tabby', {}).get('tokens') or '-')")
export PARC_BIN PARC_TOKENS_TABBY
CONFIG="$PARC_CONFIG"
CHEMINS="$PARC_GGUF_TSV"
VCHEMINS="$PARC_VLLM_TSV"
MCP="$PARC_MCP_CLAUDE"
c_t=$'\e[1;36m'; c_d=$'\e[2m'; c_v=$'\e[32m'; c_r=$'\e[31m'; c_0=$'\e[0m'
[ -t 1 ] || { c_t=''; c_d=''; c_v=''; c_r=''; c_0=''; }
err() { printf '%s%s%s\n' "$c_r" "$*" "$c_0" >&2; }
[ -r "$PARC_SECRETS" ] && . "$PARC_SECRETS"
CLE_LLAMACPP="${CLE_LLAMACPP:-${PARC_CLE_LLAMACPP:-}}"
CLE_RAPIDE="${CLE_RAPIDE:-${PARC_CLE_RAPIDE:-}}"
CLE_VLLM="${CLE_VLLM:-${PARC_CLE_VLLM:-}}"
CLE_ACVRAM="${CLE_ACVRAM:-${PARC_CLE_ACVRAM:-acvram-local}}"

lister_alias() {
  [ -x "$PARC_BIN/claude-local" ] && printf 'claude-local\tHuihui-Qwen3.6-35B-A3B-Opus-abl (RTX 5090 · port 8084)\t131072\taucun\t92\t★★★★\tagent Claude local par défaut\n'
  python3 - "$CONFIG" <<'PY'
import sys, tomllib, os
NOTES = {}
try:
    for ligne in open(os.environ['PARC_NOTES_TSV']):
        c = ligne.rstrip('\n').split('\t')
        if len(c) == 5:
            NOTES[c[0]] = (c[1], c[2], c[3], c[4])
except OSError:
    pass
VISION = {}
try:
    for ligne in open(os.path.join(os.environ['PARC_TSV_DIR'], 'vision-modeles.tsv')):
        c = ligne.rstrip('\n').split('\t')
        if len(c) >= 2:
            VISION[c[0]] = c[1]
except OSError:
    pass
ORDRE = {'acvram': 0, 'vllm': 1, 'rapide': 2, 'llamacpp': 3, 'tabby': 4, 'yals': 5}
d = tomllib.load(open(sys.argv[1], 'rb'))
MOTEURS = set(os.environ.get('PARC_MOTEURS', '').split())   # moteurs présents dans parc.toml
items = [(a, m) for a, m in d.get('models', {}).items()
         if m.get('provider') in ORDRE and m.get('provider') in MOTEURS]   # 0 moteur = 0 alias
# tous les moteurs servables, même ordre que la GUI (poste7-menus-cloture-19-09 S4) ;
# tabby/yals restent listés : le lanceur dit son refus explicite s'il ne les prend pas
ordre = ORDRE
items.sort(key=lambda kv: (ordre[kv[1]['provider']], kv[0]))
for alias, m in items:
    # fiche absente ou champ vide/« ? » : jamais « ? » (poste7-menus-cloture-19-09 § 1)
    defaut = ('inconnu', 'non mesuré', 'non mesuré', 'inconnu')
    refus, tps, qual, usage = (v if v.strip() and v.strip() != '?' else defaut[i]
                               for i, v in enumerate(NOTES.get(alias, defaut)))
    v = VISION.get(alias)
    if v == 'vision':
        usage = '👁 ' + usage + ' · vision (images)'
    elif v == 'texte-seul':
        usage = usage + ' · VL converti, texte seul'
    print('\t'.join([alias, m.get('model', '?'), str(m.get('max_context_size', '')),
                     refus, tps, qual, usage]))
PY
}

modele_servi() {  # $1 url  $2 clé
  curl -s -m 3 -H "Authorization: Bearer $2" "$1/v1/models" 2>/dev/null \
    | python3 -c 'import json,sys;print(json.load(sys.stdin)["data"][0]["id"])' 2>/dev/null
}
modele_charge() {
  local id=""
  # seuls les moteurs présents dans parc.toml sont sondés
  [ -n "${PARC_PORT_LLAMACPP:-}" ] && { id=$(modele_servi "http://127.0.0.1:$PARC_PORT_LLAMACPP" "$CLE_LLAMACPP"); [ -n "$id" ] && { basename "${id%.gguf}"; return; }; }
  [ -n "${PARC_PORT_VLLM:-}" ] && { id=$(modele_servi "http://127.0.0.1:$PARC_PORT_VLLM" "$CLE_VLLM"); [ -n "$id" ] && { echo "$id"; return; }; }
  [ -n "${PARC_PORT_RAPIDE:-}" ] && { id=$(modele_servi "http://127.0.0.1:$PARC_PORT_RAPIDE" "$CLE_RAPIDE"); [ -n "$id" ] && basename "${id%.gguf}"; }
  return 0
}

# iqm (chef 28/09) : depuis sf2, acvram rend les outils au gabarit. Invite de démarrage de claude mesurée à sec
# (faux serveur, crochets de l'utilisateur compris, scratchpad/poste1-iqm-28-09 comptes.tsv et q40.tsv) : complète
# (40 outils + MCP) 24 593-26 280 jetons selon le tokenizer ; essentielle sans MCP, variables ci-dessous posées,
# 9 764-10 300 (13 544 avec MCP : les outils MCP ne passent pas par --tools, d'où --disallowedTools). Complet seulement
# si la fenêtre servie tient 45 000 ; en dessous, jeu essentiel pour que l'invite passe. Fenêtre inconnue (moteur muet) :
# complet, comme avant. Un --tools de l'utilisateur prime. Pose MODE_OUTILS, PROMPT_BASE, OUTILS_ARGS, LIGNE_OUTILS ;
# rend 1 (message nommé) si la fenêtre ne tient pas l'invite du mode plus une réponse minimale.
mode_outils() {  # $1 fenêtre servie (vide = inconnue)  $2 modèle  $3… args claude
  local ctx="$1" modele="$2" a; shift 2
  OUTILS_ARGS=()
  MODE_OUTILS=complet; PROMPT_BASE=27000
  for a in "$@"; do case "$a" in --tools|--tools=*) MODE_OUTILS=utilisateur ;; esac; done
  if [ "$MODE_OUTILS" = complet ] && [ -n "$ctx" ] && [ "$ctx" -lt "$SEUIL_COMPLET" ] 2>/dev/null; then
    MODE_OUTILS=essentiel; PROMPT_BASE=$PROMPT_BASE_ESSENTIEL; OUTILS_ARGS=(--tools "Read,Edit,Bash,Grep" --disallowedTools "mcp__*")
  fi
  case "$MODE_OUTILS" in
    complet)     LIGNE_OUTILS="complet (fenêtre ${ctx:-inconnue} ≥ $SEUIL_COMPLET)" ;;
    essentiel)   LIGNE_OUTILS="essentiel Read, Edit, Bash, Grep, sans MCP (fenêtre $ctx < $SEUIL_COMPLET)" ;;
    utilisateur) LIGNE_OUTILS="choisis par --tools" ;;
  esac
  if [ -n "$ctx" ] && [ "$ctx" -lt $(( PROMPT_BASE + MIN_REPONSE )) ] 2>/dev/null; then
    err "alias $modele : contexte $ctx tokens insuffisant (outils $MODE_OUTILS : prompt de démarrage ~${PROMPT_BASE}, réponse mini ${MIN_REPONSE} — il faut ≥ $(( PROMPT_BASE + MIN_REPONSE )) tokens)"
    return 1
  fi
}

# menus (poste6 29/09, binaire claude 2.1.284 lu à sec, revue/poste6-menus-verdict-29-09.md) : Claude Code
# compacte quand la conversation atteint fenêtre − sortie − 13 000 (tampon de résumé, fonction SQ du binaire), bloque
# à fenêtre − sortie − 3 000, et CLAUDE_CODE_AUTO_COMPACT_WINDOW n'accepte que 100k-1M (sans effet sous 100 k). Une
# invite plus lourde que ce seuil (32 768 − 8 192 − 13 000 = 11 576, pour 13 938 jetons mesurés en edz) rend la
# compaction impossible : la conversation grossit jusqu'au 400 du moteur (« invite de 32 8xx jetons au-delà de
# max_model_len 32 768 »). D'où : la sortie est ce qui laisse à la conversation MARGE_CONVERSATION jetons avant le
# seuil ; en dessous de SORTIE_MIN, refus nommé avec la fenêtre nécessaire. Constantes du binaire 2.1.284 : à relire
# à chaque version de claude (strings, « Auto-compact window »). Constantes définies en tête du fichier (bloc « Seuils »).
sortie_pour() {  # $1 fenêtre  $2 invite (jetons)  $3 modèle → imprime la sortie ; rc 1 (message nommé) si rien ne tient
  local ctx="$1" invite="$2" modele="$3"
  local sortie=$(( ctx - TAMPON_COMPACTION - invite - MARGE_CONVERSATION ))
  [ "$sortie" -gt "$SORTIE_MAX" ] && sortie=$SORTIE_MAX
  if [ "$sortie" -lt "$SORTIE_MIN" ]; then
    err "alias $modele : fenêtre $ctx jetons insuffisante pour l'invite mesurée ($invite jetons, outils $MODE_OUTILS) — Claude Code compacte à fenêtre − sortie − $TAMPON_COMPACTION ; il faut ≥ $(( invite + TAMPON_COMPACTION + MARGE_CONVERSATION + SORTIE_MIN )) jetons (invite + $TAMPON_COMPACTION + $MARGE_CONVERSATION de conversation + $SORTIE_MIN de sortie)"
    return 1
  fi
  echo "$sortie"
}
# Mesure de l'invite de démarrage : claude -p contre un serveur factice local qui capture la requête portant la
# sentinelle (les crochets de l'utilisateur peuvent en envoyer d'autres), comptée par /v1/messages/count_tokens du
# moteur (acvram) ; moteur muet (llama.cpp, vLLM) ou capture manquée : octets/3,3 (mesuré 3,56-3,65 o/jeton, LFM2 et
# Qwen, ratio pris conservateur). PARC_INVITE_JETONS=<n> impose la valeur (tests, edz) ; PARC_EXEC ou
# PARC_MESURE_INVITE=0 ou --afficher : pas d'essai, PROMPT_BASE. Imprime deux lignes : jetons, origine. Un crochet
# SessionStart lent retient claude (44 s vus le 29/09, ICM) : au-delà de 20 s l'essai est abandonné, PROMPT_BASE.
mesurer_invite() {  # $1 base_url  $2 clé  $3 modèle  $4… args claude (seuls --tools/--disallowedTools comptent)
  local url="$1" cle="$2" modele="$3"; shift 3
  if [ -n "${PARC_INVITE_JETONS:-}" ]; then printf '%s\nimposée\n' "$PARC_INVITE_JETONS"; return; fi
  if [ -n "${PARC_EXEC:-}" ] || [ "${AFFICHER:-0}" = 1 ] || [ "${PARC_MESURE_INVITE:-1}" = 0 ]; then printf '%s\nestimée (sans essai)\n' "$PROMPT_BASE"; return; fi
  local outils=() a prev="" sentinelle="acvram-mesure-invite-$$"
  for a in "$@"; do
    case "$prev" in --tools|--disallowedTools|--allowedTools) outils+=("$prev" "$a") ;; esac
    case "$a" in --tools=*|--disallowedTools=*|--allowedTools=*) outils+=("$a") ;; esac
    prev="$a"
  done
  local capture; capture=$(mktemp -t acvram-invite.XXXXXX)
  local port; port=$(python3 -c 'import socket; s=socket.socket(); s.bind(("127.0.0.1",0)); print(s.getsockname()[1])')
  python3 - "$port" "$capture" "$sentinelle" <<'PY' &
import http.server, json, sys
port, capture, sentinelle = int(sys.argv[1]), sys.argv[2], sys.argv[3]
class H(http.server.BaseHTTPRequestHandler):
    def _json(self, code, d):
        b = json.dumps(d).encode(); self.send_response(code)
        self.send_header("content-type", "application/json"); self.send_header("content-length", str(len(b)))
        self.end_headers(); self.wfile.write(b)
    def do_GET(self): self._json(200, {"object": "list", "data": []})
    def do_POST(self):
        b = self.rfile.read(int(self.headers.get("content-length", 0)))
        if sentinelle.encode() in b:
            open(capture, "wb").write(b)
        self._json(400, {"type": "error", "error": {"type": "invalid_request_error", "message": "mesure de l'invite"}})
    def log_message(self, *a): pass
http.server.ThreadingHTTPServer(("127.0.0.1", port), H).serve_forever()
PY
  local pid_faux=$!
  sleep 0.2
  ANTHROPIC_BASE_URL="http://127.0.0.1:$port" ANTHROPIC_AUTH_TOKEN=x ANTHROPIC_MODEL="$modele" \
    timeout 20 "${PARC_CLAUDE/#\~/$HOME}" --strict-mcp-config --mcp-config "$MCP" --model "$modele" --fallback-model "$modele" \
    --settings '{"env":{"CLAUDE_CODE_ATTRIBUTION_HEADER":"0"}}' "${OUTILS_ARGS[@]}" "${outils[@]}" \
    -p "$sentinelle" </dev/null >/dev/null 2>&1   # sur 400, claude réessaie deux fois et sort (~0,4 s) ; --max-turns 1 le laisse pendu
  kill "$pid_faux" 2>/dev/null; wait "$pid_faux" 2>/dev/null
  local n="" origine
  if [ -s "$capture" ]; then
    n=$(curl -s -m 20 -X POST "$url/v1/messages/count_tokens" -H "x-api-key: $cle" -H "Authorization: Bearer $cle" \
          -H 'anthropic-version: 2023-06-01' -H 'content-type: application/json' --data-binary "@$capture" 2>/dev/null \
        | python3 -c 'import json,sys
try: v = json.load(sys.stdin).get("input_tokens")
except Exception: v = None
print(v if isinstance(v, int) and v > 0 else "")' 2>/dev/null)
    if [ -n "$n" ]; then origine="mesurée par le moteur"
    else n=$(( $(stat -c %s "$capture") * 10 / 33 )); origine="estimée à octets/3,3"; fi
  else
    n="$PROMPT_BASE"; origine="estimée (capture manquée)"
  fi
  rm -f "$capture"; printf '%s\n%s\n' "$n" "$origine"
}

lancer_claude() {  # $1 base_url  $2 clé  $3 modèle servi  $4 contexte  [$@ args claude]
  local url="$1" cle="$2" modele="$3" ctx="$4"; shift 4
  local code
  code=$(curl -s -m 8 -o /dev/null -w '%{http_code}' -X POST "$url/v1/messages" \
    -H "x-api-key: $cle" -H "Authorization: Bearer $cle" -H 'anthropic-version: 2023-06-01' \
    -H 'content-type: application/json' \
    -d "{\"model\":\"$modele\",\"max_tokens\":1,\"messages\":[{\"role\":\"user\",\"content\":\".\"}]}")
  case "$code" in
    404|405) err "Ce moteur n'expose pas /v1/messages (API Anthropic) — choisir un alias llamacpp-* ou rapide-*."; exit 1 ;;
    000) err "Moteur injoignable sur $url"; exit 1 ;;
  esac
  export ANTHROPIC_BASE_URL="$url" ANTHROPIC_AUTH_TOKEN="$cle"
  export ANTHROPIC_MODEL="$modele" ANTHROPIC_SMALL_FAST_MODEL="$modele"
  export ANTHROPIC_DEFAULT_OPUS_MODEL="$modele" ANTHROPIC_DEFAULT_SONNET_MODEL="$modele" ANTHROPIC_DEFAULT_HAIKU_MODEL="$modele"
  export CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1 DISABLE_NON_ESSENTIAL_MODEL_CALLS=1
  # Q40 (poste4 29/09, sources primaires ; effet mesuré à sec, q40.tsv) : auto-mémoire et skills intégrés retirés
  # de l'invite (−565 jetons) — ni l'une ni les autres ne servent sur un modèle local.
  export CLAUDE_CODE_DISABLE_AUTO_MEMORY=1 CLAUDE_CODE_DISABLE_BUNDLED_SKILLS=1
  # Fenêtre RÉELLE : acvram clampe max_model_len à ce que tient sa chauffe (Qwen3-Coder-30B : 39 936 pour 65 536
  # demandés, t5e 27/09) ; la colonne 3 du TSV n'est qu'une demande. Moteur muet sur max_model_len : ctx inchangé.
  local servi
  servi=$(curl -s -m 3 -H "Authorization: Bearer $cle" "$url/v1/models" 2>/dev/null | python3 -c '
import json, sys
for m in json.load(sys.stdin).get("data", []):
    v = m.get("max_model_len") or (m.get("acvram") or {}).get("max_model_len")   # vLLM à plat, acvram sous « acvram »
    if m.get("id") == sys.argv[1] and str(v or "").isdigit():
        print(v)' "$modele" 2>/dev/null || true)
  # dans les DEUX sens : servi à 29 096 (CTX_CLIENT_MIN) pour une colonne 3 à 15 360, claude était refusé (edz 28/09,
  # ornith et kimi-linear 35B) — seule une baisse était prise
  [ -n "$servi" ] && ctx="$servi"
  mode_outils "$ctx" "$modele" "$@" || exit 1
  [ -n "$ctx" ] && export CLAUDE_CODE_MAX_CONTEXT_TOKENS="$ctx"   # fenêtre réelle du moteur
  # claude réserve sa sortie maximale (32 000) DANS la fenêtre : à 32 768 il refuse sans rien envoyer
  # (« Prompt is too long », 0 requête — t5e 27/09, faux serveur). Sortie = ce qui reste après l'invite, 8 192 au plus.
  # menus (poste6 29/09) : l'invite est MESURÉE (essai à blanc, voir mesurer_invite) et la sortie laisse à la
  # conversation MARGE_CONVERSATION jetons avant le seuil de compaction ; fenêtre trop petite : refus nommé.
  if [ -n "$ctx" ]; then
    local invite sortie ORIGINE_INVITE
    { read -r invite; read -r ORIGINE_INVITE; } < <(mesurer_invite "$url" "$cle" "$modele" "$@")
    sortie=$(sortie_pour "$ctx" "$invite" "$modele") || exit 1
    export CLAUDE_CODE_MAX_OUTPUT_TOKENS="$sortie"
    LIGNE_INVITE="invite $invite jetons ($ORIGINE_INVITE) · sortie $sortie · compaction à $(( ctx - sortie - TAMPON_COMPACTION ))"
  fi
  printf '\n%s→ claude sur %s (%s)%s\n' "$c_t" "$modele" "$url" "$c_0"
  printf '%soutils : %s%s\n' "$c_t" "$LIGNE_OUTILS" "$c_0"
  [ -n "${LIGNE_INVITE:-}" ] && printf '%s%s%s\n' "$c_t" "$LIGNE_INVITE" "$c_0"
  printf '\n'
  # UN SEUL constructeur : --afficher imprime le tableau que l'exec reçoit (poste7 21/09) ;
  # PARC_EXEC=<programme> le reçoit à la place de claude (test à sec, quatre moteurs).
  # Q40 : l'en-tête « x-anthropic-billing-header » ouvre l'invite système ; une valeur qui change invalide le cache
  # de préfixe du moteur local dès le jeton 0. Il ne se coupe que par les réglages (l'export shell ne suffit pas,
  # renezander.com) ; vérifié à sec : absent de l'invite avec ce --settings.
  local SETTINGS_LOCAL='{"env":{"CLAUDE_CODE_ATTRIBUTION_HEADER":"0"}}'
  local CMD=("${PARC_CLAUDE/#\~/$HOME}" --strict-mcp-config --mcp-config "$MCP" --model "$modele" --fallback-model "$modele" \
    --settings "$SETTINGS_LOCAL" "${OUTILS_ARGS[@]}" "$@")
  if [ "${AFFICHER:-0}" = 1 ]; then   # claude-modele --afficher <alias> : montre sans lancer
    env | grep -E '^(ANTHROPIC_|DISABLE_|CLAUDE_CODE_)' | sort
    printf 'commande :'; printf ' %q' "${CMD[@]}"; printf '\n'
    exit 0
  fi
  [ -n "${PARC_EXEC:-}" ] && exec "$PARC_EXEC" "${CMD[@]}"
  exec "${CMD[@]}"
}

. "$PARC_LIB"
choix=""
AFFICHER=0
[ "${1:-}" = "--afficher" ] && { AFFICHER=1; shift; }
if [ $# -gt 0 ] && [[ "$1" != -* ]]; then choix="$1"; shift; fi
if [ -z "$choix" ]; then
  choix=$(choisir_alias "Claude local — parc de modèles (vLLM · llama.cpp · appoint 3080 Ti)" "$(modele_charge)") || exit 1
  # parc vide (rc 0, message déjà nommé par choisir_alias) : rien à lancer, sortie propre
  [ -n "$choix" ] || exit 0
fi

case "$choix" in
  claude-local)
    exec "$PARC_BIN/claude-local" "$@" ;;
  acvram-*)
    # moteur acvram : NVFP4 (sm_120) / INT4 (2e carte),
    # /v1/messages (API Anthropic) expose nativement par le serveur.
    # fenêtre minimale = FENETRE_MIN (tête du fichier) : ce que sortie_pour exige de l'invite essentielle estimée,
    # 29 120 (menus, poste6 29/09 ; 29 096 avant) — le même chiffre que la GUI affiche en refus (ph1).
    CTX_CLIENT_MIN=$FENETRE_MIN "$PARC_BIN/acvram-serveur" "$choix" || exit 1
    ctx=$(grep "^$choix	" "$PARC_ACVRAM_TSV" 2>/dev/null | cut -f3)
    ctx_client=$(grep "^$choix	" "$PARC_ACVRAM_TSV" 2>/dev/null | cut -f4)
    [ -n "$ctx_client" ] && [ "$ctx_client" -gt "${ctx:-0}" ] 2>/dev/null && ctx="$ctx_client"
    lancer_claude "http://127.0.0.1:${PARC_PORT_ACVRAM:-8090}" "$CLE_ACVRAM" "$choix" "${ctx:-32768}" "$@" ;;
  tabby-*)
    err "TabbyAPI n'expose pas l'API Anthropic : choisir un alias llamacpp-*, rapide-*, vllm-* ou acvram-*."; exit 1 ;;
  yals-*)
    err "YALS n'expose pas l'API Anthropic (API OpenAI seule, lanceur kimi-yals) : choisir un alias llamacpp-*, rapide-*, vllm-* ou acvram-*."; exit 1 ;;
  rapide-*)
    "$PARC_BIN/llamacpp-appoint" || exit 1
    lancer_claude "http://127.0.0.1:${PARC_PORT_RAPIDE:-8081}" "$CLE_RAPIDE" "$(modele_servi "http://127.0.0.1:${PARC_PORT_RAPIDE:-8081}" "$CLE_RAPIDE")" 65536 "$@" ;;
  vllm-*)
    ligne=$(grep "^$choix	" "$VCHEMINS" 2>/dev/null | head -1)
    [ -n "$ligne" ] || { err "Alias absent de $VCHEMINS : $choix"; exit 1; }
    dossier=$(printf '%s' "$ligne" | cut -f2); lmax=$(printf '%s' "$ligne" | cut -f3)
    servi=$(modele_servi "http://127.0.0.1:${PARC_PORT_VLLM:-8000}" "$CLE_VLLM")
    if [ -n "$servi" ] && [ "$servi" = "$(basename "$dossier")" ]; then
      printf '%sModèle déjà servi par vLLM.%s\n' "$c_v" "$c_0"
    else
      "$PARC_BIN/vllm-serveur" "$dossier" "$lmax" || exit 1
    fi
    lancer_claude "http://127.0.0.1:${PARC_PORT_VLLM:-8000}" "$CLE_VLLM" "$(basename "$dossier")" "$lmax" "$@" ;;
  llamacpp-*)
    ligne=$(grep "^$choix	" "$CHEMINS" 2>/dev/null | head -1)
    [ -n "$ligne" ] || { err "Alias absent de $CHEMINS : $choix"; exit 1; }
    dossier=$(printf '%s' "$ligne" | cut -f2); ctx=$(printf '%s' "$ligne" | cut -f3); gab=$(printf '%s' "$ligne" | cut -f4)
    case "$gab" in ~/*) gab="$HOME/${gab#\~/}" ;; esac
    attendu=$(find "$dossier" -maxdepth 1 -name "*.gguf" -size +1M ! -iname "*mmproj*" ! -name "gabarit*" | sort | head -1)
    servi=$(modele_servi "http://127.0.0.1:${PARC_PORT_LLAMACPP:-8080}" "$CLE_LLAMACPP")
    if [ -n "$servi" ] && [ "$(basename "${servi%.gguf}")" = "$(basename "${attendu%.gguf}")" ]; then
      printf '%sModèle déjà servi par llama.cpp.%s\n' "$c_v" "$c_0"
    else
      GABARIT="$gab" "$PARC_BIN/llamacpp-serveur" "$dossier" "$ctx" || exit 1
    fi
    lancer_claude "http://127.0.0.1:${PARC_PORT_LLAMACPP:-8080}" "$CLE_LLAMACPP" "$(modele_servi "http://127.0.0.1:${PARC_PORT_LLAMACPP:-8080}" "$CLE_LLAMACPP")" "$(cat "${PARC_EXTRA_CTX_ACTUEL:-/dev/null/absent}" 2>/dev/null || echo "$ctx")" "$@" ;;
  *)
    err "Alias hors moteurs directs : $choix (attendu : claude-local, acvram-*, llamacpp-*, rapide-*, vllm-*)"; exit 1 ;;
esac
