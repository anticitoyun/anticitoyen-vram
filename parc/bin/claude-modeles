#!/usr/bin/python3
# claude-modeles — Claude Code sur le parc de modèles locaux (GTK4 / libadwaita).
# Fork de kimi-modeles : même parc, mêmes fichiers ; « Ouvrir dans Claude » appelle
# claude-modele, « Ouvrir ComfyUI » démarre ComfyUIClaude (piloté par le MCP comfyui).
#
# Tout le commun (parc, moteurs, fiches, filtres, fenêtre) vit dans le paquet
# parc/lib/menu_modeles/ ; ce lanceur ne porte que les divergences propres à
# claude (nom, icône, couleurs, bouton web, refus tabby/yals), réunies dans PROFIL.
#
# Soutenir : https://buymeacoffee.com/anticitoyen
import sys
from pathlib import Path

import gi

gi.require_version("Gtk", "4.0")
gi.require_version("Adw", "1")
from gi.repository import Adw, Gio, GLib, Gtk  # noqa: E402

# ─── parc et commun des deux menus (parc/lib/menu_modeles) ───
sys.path.insert(0, "/usr/share/acvram-parc/lib")
_LIB_LOCALE = Path(__file__).resolve().parent.parent / "lib"
if (_LIB_LOCALE / "acvram_parc.py").exists():
    sys.path.insert(0, str(_LIB_LOCALE))
from menu_modeles.config import PARC, CONFIG, GUI_TEST  # noqa: E402
from menu_modeles.fenetre import Fenetre, appliquer_habillage  # noqa: E402

# ─── divergences propres à claude-modeles (S5, sage-menus-cloture-19-09) ───
ICONE = PARC.icone_claude
COMFY_START = Path(PARC.extras["comfy_start"]) if PARC.extras.get("comfy_start") else None
COMFY_URL = str(PARC.extras.get("comfy_url", "http://127.0.0.1:8188"))
PORT_WEB = int(PARC.extras.get("port_web_kimi", 58627))

PROFIL = {
    "nom": "Claude",
    "titre_fenetre": "Claude Modèles",
    "cli": "claude-modele",
    "icone": "claude-local",
    "terminal_titre": "Claude local",
    "app_id": "fr.anticitoyen.ClaudeModeles",
    "accent_bg": "#7c3aed",
    "accent_color": "#a78bfa",
    "refuse_tabby_yals": True,
    "web": "comfyui",
    "web_label": "Ouvrir ComfyUI",
    "web_tooltip": ("Démarre ComfyUIClaude (port 8188) si besoin et ouvre son interface ; "
                    "le MCP comfyui de Claude le pilote aussi"),
    "comfy_start": COMFY_START,
    "comfy_url": COMFY_URL,
    "port_web": PORT_WEB,
    "kimi_bin": None,
}


class Application(Adw.Application):
    def __init__(self):
        # sous test : instance non unique, sinon `run` réveille l'instance déjà ouverte de l'utilisateur par D-Bus
        # et rend 0 sans rien jouer (vu le 21/09 : rc 0, aucune ligne GUI_TEST)
        super().__init__(application_id=PROFIL["app_id"],
                         flags=Gio.ApplicationFlags.NON_UNIQUE if GUI_TEST else Gio.ApplicationFlags.DEFAULT_FLAGS)

    def do_activate(self):
        appliquer_habillage(PROFIL["accent_bg"], PROFIL["accent_color"])
        fen = self.props.active_window or Fenetre(self, PROFIL)
        if ICONE.exists():
            Gtk.Window.set_default_icon_name(PROFIL["icone"])
        fen.present()
        if GUI_TEST:
            GLib.idle_add(fen.test_jouer)


def main():
    if not CONFIG.exists():
        print(f"config.toml introuvable : {CONFIG}", file=sys.stderr)
        return 1
    app = Application()
    code = app.run(sys.argv)
    return getattr(app, "rc_test", 0) or code


if __name__ == "__main__":
    raise SystemExit(main())
