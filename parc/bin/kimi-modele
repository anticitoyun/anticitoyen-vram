#!/usr/bin/env bash
# kimi-modele — lanceur unifié kimi : UN menu, trois moteurs directs.
#   llamacpp-*  → llama.cpp (GGUF)       http://127.0.0.1:8080/v1
#   vllm-*      → vLLM (AWQ/FP8/BF16)    http://127.0.0.1:8000/v1
#   tabby-*     → TabbyAPI (EXL2/EXL3)   http://127.0.0.1:5000/v1
# Usage : kimi-modele [alias] [arguments kimi...]
set -uo pipefail
# Seuil de fenêtre — UNE SEULE SOURCE, lue aussi par la GUI kimi-modeles via `kimi-modele --seuils` (90q, poste6 30/09, même
# méthode que ph1/claude-modele). KIMI_MCP_CTX_MIN (d19, chef 27/09) : contexte SERVI à partir duquel kimi_local() garde
# les MCP (invite MCP 58-64 k) ; en dessous, sans MCP — l'alias se lance quand même. Aucun plancher de refus générique
# (seuil_minimum vide : kimi-modele ne refuse jamais une fenêtre lui-même, hors le repli propre à acvram-serveur).
KIMI_MCP_CTX_MIN="${KIMI_MCP_CTX_MIN:-65536}"
# --seuils : imprime et sort AVANT de charger le parc (aucun python, aucun parc.toml : la GUI le joue au démarrage)
if [ "${1:-}" = "--seuils" ]; then printf 'seuil_complet=%s\nseuil_minimum=\n' "$KIMI_MCP_CTX_MIN"; exit 0; fi

# parc.toml (acvram-parc) : chemins, ports, clés et moteurs du poste ; rien n'est codé ici
PARC_LIB_PY=/usr/share/acvram-parc/lib/acvram_parc.py
_ici=$(dirname "$(readlink -f "$0")"); [ -f "$_ici/../lib/acvram_parc.py" ] && PARC_LIB_PY="$_ici/../lib/acvram_parc.py"
set -a; eval "$(python3 "$PARC_LIB_PY" --env)"; set +a
read -r PARC_BIN PARC_TOKENS_TABBY < <(python3 -c "import sys; sys.path.insert(0, '$(dirname "$PARC_LIB_PY")'); from acvram_parc import charger; P = charger(); print(P.bin, P.moteurs.get('tabby', {}).get('tokens') or '-')")
export PARC_BIN PARC_TOKENS_TABBY
CONFIG="$PARC_CONFIG"
KIMI="${PARC_KIMI/#\~/$HOME}"
CHEMINS="$PARC_GGUF_TSV"
VCHEMINS="$PARC_VLLM_TSV"
[ -r "$PARC_SECRETS" ] && . "$PARC_SECRETS"

c_t=$'\e[1;36m'; c_d=$'\e[2m'; c_v=$'\e[32m'; c_r=$'\e[31m'; c_0=$'\e[0m'
[ -t 1 ] || { c_t=''; c_d=''; c_v=''; c_r=''; c_0=''; }
err() { printf '%s%s%s\n' "$c_r" "$*" "$c_0" >&2; }

# --- alias des trois moteurs directs, 7 colonnes tabulées ---------------------
lister_alias() {
  python3 - "$CONFIG" <<'PY'
import sys, tomllib, os
NOTES = {}
try:
    for ligne in open(os.environ['PARC_NOTES_TSV']):
        c = ligne.rstrip('\n').split('\t')
        if len(c) == 5:
            NOTES[c[0]] = (c[1], c[2], c[3], c[4])
except OSError:
    pass
VISION = {}
try:
    for ligne in open(os.path.join(os.environ['PARC_TSV_DIR'], 'vision-modeles.tsv')):
        c = ligne.rstrip('\n').split('\t')
        if len(c) >= 2:
            VISION[c[0]] = c[1]
except OSError:
    pass
ORDRE = {'acvram': 0, 'vllm': 1, 'rapide': 2, 'llamacpp': 3, 'tabby': 4, 'yals': 5}
d = tomllib.load(open(sys.argv[1], 'rb'))
MOTEURS = set(os.environ.get('PARC_MOTEURS', '').split())   # moteurs présents dans parc.toml
items = [(a, m) for a, m in d.get('models', {}).items()
         if m.get('provider') in ORDRE and m.get('provider') in MOTEURS]   # 0 moteur = 0 alias
# tous les moteurs servables, même ordre que la GUI (poste7-menus-cloture-19-09 S4) ;
# tabby/yals restent listés : le lanceur dit son refus explicite s'il ne les prend pas
ordre = ORDRE
items.sort(key=lambda kv: (ordre[kv[1]['provider']], kv[0]))
for alias, m in items:
    # fiche absente ou champ vide/« ? » : jamais « ? » (poste7-menus-cloture-19-09 § 1)
    defaut = ('inconnu', 'non mesuré', 'non mesuré', 'inconnu')
    refus, tps, qual, usage = (v if v.strip() and v.strip() != '?' else defaut[i]
                               for i, v in enumerate(NOTES.get(alias, defaut)))
    v = VISION.get(alias)
    if v == 'vision':
        usage = '👁 ' + usage + ' · vision (images)'
    elif v == 'texte-seul':
        usage = usage + ' · VL converti, texte seul'
    print('\t'.join([alias, m.get('model', '?'), str(m.get('max_context_size', '')),
                     refus, tps, qual, usage]))
PY
}

# point vert du menu : modèle servi par le gros moteur actif, sinon l'appoint
modele_charge() {
  local id=""
  # seuls les moteurs présents dans parc.toml sont sondés
  [ -n "${PARC_PORT_LLAMACPP:-}" ] && id=$(curl -s -m 1 -H "Authorization: Bearer ${CLE_LLAMACPP:-${PARC_CLE_LLAMACPP:-}}" \
    "http://127.0.0.1:$PARC_PORT_LLAMACPP/v1/models" 2>/dev/null \
    | python3 -c 'import json,sys;print(json.load(sys.stdin)["data"][0]["id"])' 2>/dev/null)
  [ -n "$id" ] && { basename "${id%.gguf}"; return; }
  [ -n "${PARC_PORT_VLLM:-}" ] && id=$(curl -s -m 1 -H "Authorization: Bearer ${CLE_VLLM:-${PARC_CLE_VLLM:-}}" \
    "http://127.0.0.1:$PARC_PORT_VLLM/v1/models" 2>/dev/null \
    | python3 -c 'import json,sys;print(json.load(sys.stdin)["data"][0]["id"])' 2>/dev/null)
  [ -n "$id" ] && { echo "$id"; return; }
  [ -n "${PARC_PORT_TABBY:-}" ] && id=$(curl -s -m 1 -H "Authorization: Bearer ${CLE_TABBY:-$(awk '/^api_key:/{print $2}' "$PARC_TOKENS_TABBY" 2>/dev/null)}" \
    "http://127.0.0.1:$PARC_PORT_TABBY/v1/model" 2>/dev/null \
    | python3 -c 'import json,sys;print(json.load(sys.stdin).get("id",""))' 2>/dev/null)
  [ -n "$id" ] && { echo "$id"; return; }
  [ -n "${PARC_PORT_RAPIDE:-}" ] && id=$(curl -s -m 1 -H "Authorization: Bearer ${CLE_RAPIDE:-${PARC_CLE_RAPIDE:-}}" \
    "http://127.0.0.1:$PARC_PORT_RAPIDE/v1/models" 2>/dev/null \
    | python3 -c 'import json,sys;print(json.load(sys.stdin)["data"][0]["id"])' 2>/dev/null)
  [ -n "$id" ] && basename "${id%.gguf}"
}

. "$PARC_LIB"

# --- programme principal ------------------------------------------------------
choix=""
if [ $# -gt 0 ] && [[ "$1" != -* ]]; then
  choix="$1"; shift
fi
if [ -z "$choix" ]; then
  choix=$(choisir_alias "Modèles locaux (vLLM · llama.cpp · TabbyAPI · appoint 3080 Ti)" "$(modele_charge)") || exit 1
  # parc vide (rc 0, message déjà nommé par choisir_alias) : rien à lancer, sortie propre
  [ -n "$choix" ] || exit 0
fi

# Alias LOCAUX : kimi démarre sans MCP (t5e 27/09, décision utilisateur). Invite de démarrage mesurée (tokenizer
# Qwen3) : 58 635 jetons avec les MCP globaux (tokensave + icm : 29 555), 29 107 sans — les moteurs locaux tiennent
# 25-42 k. kimi n'a pas d'option MCP par session : un KIMI_CODE_HOME dédié, régénéré à chaque lancement (mcp.json vide,
# AGENTS.md lié, config = copie de celle de l'utilisateur, seul max_context_size de l'alias mis au contexte SERVI).
# La config de l'utilisateur et ses sessions distantes ne sont pas touchées.
# d19 (27/09, décision chef) : les MCP sont GARDÉS pour un alias dont le contexte SERVI tient l'invite MCP avec marge
# (≥ KIMI_MCP_CTX_MIN, 65 536 : invite 58-64 k) — 35B, 30B, 27B depuis le préfill par tranches ; sans MCP en dessous, et
# quand le moteur ne dit pas son contexte (choix prudent : une invite de 58 k sur 32 k servis rend 400).
kimi_local() {  # $1 alias  [$2 contexte servi]
  local d="${PARC_KIMI_LOCAL:-$HOME/.kimi-code-local}" src; src=$(dirname "$CONFIG")
  mkdir -p "$d" || return 1
  if [ -n "${2:-}" ] && [ "$2" -ge "$KIMI_MCP_CTX_MIN" ] 2>/dev/null && [ -e "$src/mcp.json" ]; then
    rm -f "$d/mcp.json"; ln -s "$src/mcp.json" "$d/mcp.json"
    printf '%skimi : MCP gardés (contexte servi %s ≥ %s)%s\n' "$c_d" "$2" "$KIMI_MCP_CTX_MIN" "$c_0" >&2
  else
    rm -f "$d/mcp.json"; printf '{"mcpServers": {}}\n' > "$d/mcp.json"
  fi
  [ -e "$src/AGENTS.md" ] && ln -sfn "$src/AGENTS.md" "$d/AGENTS.md"
  # les CLE_* de ia-secrets.env sont des variables du shell, non exportées : passées explicitement.
  # tabby (edz définitif 30/09, 0/17, poste6) : TabbyAPI authentifie avec SON api_tokens.yml (qu'il génère lui-même), et le
  # routeur 8790 n'accepte à l'entrée que cette clé-là pour /tabby — CLE_TABBY de ia-secrets.env (installateur 28/09) lui est
  # inconnue : 16 × 401 « clé d'API invalide » au journal du routeur. La copie locale prend la clé du fichier, lue ici.
  local cle_tabby=""; [ -r "${PARC_TOKENS_TABBY:-}" ] && cle_tabby=$(awk '/^api_key:/{print $2; exit}' "$PARC_TOKENS_TABBY")
  CLE_VLLM="${CLE_VLLM:-}" CLE_LLAMACPP="${CLE_LLAMACPP:-}" CLE_RAPIDE="${CLE_RAPIDE:-}" CLE_TABBY="$cle_tabby" \
  python3 - "$CONFIG" "$d/config.toml" "$1" "${2:-}" <<'PY' || return 1
import os, re, sys
src, dst, alias, ctx = sys.argv[1:5]
t = open(src, encoding="utf-8").read()
# 29/09 (edz liste-1, kimi rc 1 « 401 clé d'API invalide » sur TOUS les moteurs hors acvram) : kimi-routeur (8790)
# n'accepte qu'une clé égale à une clé moteur de ia-secrets.env (CLE_*), que parc-installer a CRÉÉ le 28/09 avec des
# clés aléatoires ; config.toml gardait les défauts d'avant (vllm-local…). Les fournisseurs routés prennent ici,
# dans la copie locale seulement, la clé CLE_<MOTEUR> courante — une rotation des secrets ne casse plus kimi.
for moteur in ("vllm", "llamacpp", "rapide", "tabby"):   # tabby : clé d'api_tokens.yml (30/09), pas de secrets
    cle = os.environ.get(f"CLE_{moteur.upper()}")
    if cle:
        bloc = re.compile(r"(^\[providers\." + moteur + r"\]\n(?:(?!^\[).*\n)*?)api_key = \"[^\"]*\"", re.M)
        t = bloc.sub(lambda m: m.group(1) + 'api_key = "' + cle + '"', t, count=1)
if ctx.isdigit():
    # seul le bloc [models.<alias>] change ; le reste est recopié octet pour octet
    motif = re.compile(r"(^\[models\." + re.escape(alias) + r"\]\n(?:(?!^\[).*\n)*?)max_context_size = \d+", re.M)
    t = motif.sub(lambda m: m.group(1) + f"max_context_size = {ctx}", t, count=1)
open(dst, "w", encoding="utf-8").write(t)
PY
  export KIMI_CODE_HOME="$d"
}
ctx_servi() {  # $1 url  $2 alias → max_model_len servi (acvram : data[0].acvram ; vLLM : à plat), vide sinon
  curl -s -m 3 "$1/v1/models" 2>/dev/null | python3 -c '
import json, sys
for m in json.load(sys.stdin).get("data", []):
    v = m.get("max_model_len") or (m.get("acvram") or {}).get("max_model_len")
    if m.get("id") == sys.argv[1] and str(v or "").isdigit():
        print(v)' "$2" 2>/dev/null || true
}
kimi_local "$choix" || { err "kimi local : préparation de ${PARC_KIMI_LOCAL:-$HOME/.kimi-code-local} impossible"; exit 1; }

# mode Auto dès le démarrage, sauf en mode prompt (-p) où kimi le refuse
AUTO=(--auto)
for arg in "$@"; do
  case "$arg" in -p|--prompt|--output-format) AUTO=(); break;; esac
done

case "$choix" in
  acvram-*)
    # moteur acvram : NVFP4 (sm_120) / INT4 (2e carte)
    # le plus grand contexte que le moteur tient (clampé par la chauffe) ; si la carte ne peut pas même planifier
    # 65 536 (budget KV d'un dense, devstral-24B), 34 816 = invite sans MCP (29 107) + 4 096 de réponse, arrondi.
    # 90q : la demande haute EST KIMI_MCP_CTX_MIN (tête du fichier) — servi à cette fenêtre, kimi_local garde les MCP.
    CTX_CLIENT_MIN=$KIMI_MCP_CTX_MIN "$PARC_BIN/acvram-serveur" "$choix" \
      || CTX_CLIENT_MIN=34816 "$PARC_BIN/acvram-serveur" "$choix" "${KIMI_CTX_REPLI:-34816}" || exit 1
    kimi_local "$choix" "$(ctx_servi "http://127.0.0.1:${PARC_PORT_ACVRAM:-8090}" "$choix")" || exit 1
    printf '\n%s→ kimi -m %s%s\n\n' "$c_t" "$choix" "$c_0"
    exec "$KIMI" "${AUTO[@]}" -m "$choix" "$@"
    ;;
  tabby-*)
    exec "$PARC_BIN/kimi-tabby" "$choix" "$@"
    ;;
  yals-*)
    exec "$PARC_BIN/kimi-yals" "$choix" "$@"
    ;;
  rapide-*)
    "$PARC_BIN/llamacpp-appoint" || exit 1
    printf '\n%s→ kimi -m %s%s\n\n' "$c_t" "$choix" "$c_0"
    exec "$KIMI" "${AUTO[@]}" -m "$choix" "$@"
    ;;
  vllm-*)
    # chaque alias vLLM nomme SON dossier et SON contexte de service : sans cette
    # table, le lanceur servait son modèle par défaut et kimi interrogeait ensuite
    # un modèle absent du serveur (404 au premier message).
    ligne=$(grep "^$choix	" "$VCHEMINS" 2>/dev/null | head -1)
    [ -n "$ligne" ] || { err "Alias absent de $VCHEMINS : $choix"; exit 1; }
    dossier=$(printf '%s' "$ligne" | cut -f2)
    lmax=$(printf '%s' "$ligne" | cut -f3)
    [ -r "$PARC_SECRETS" ] && . "$PARC_SECRETS"
    servi=$(curl -s -m 3 -H "Authorization: Bearer ${CLE_VLLM:-${PARC_CLE_VLLM:-}}" \
      "http://127.0.0.1:${PARC_PORT_VLLM:-8000}/v1/models" 2>/dev/null \
      | python3 -c 'import json,sys;print(json.load(sys.stdin)["data"][0]["id"])' 2>/dev/null)
    if [ -n "$servi" ] && [ "$servi" = "$(basename "$dossier")" ]; then
      printf '%sModèle déjà servi par vLLM.%s\n' "$c_v" "$c_0"
    else
      "$PARC_BIN/vllm-serveur" "$dossier" "$lmax" || exit 1
    fi
    printf '\n%s→ kimi -m %s%s\n\n' "$c_t" "$choix" "$c_0"
    exec "$KIMI" "${AUTO[@]}" -m "$choix" "$@"
    ;;
  llamacpp-*)
    ligne=$(grep "^$choix	" "$CHEMINS" 2>/dev/null | head -1)
    [ -n "$ligne" ] || { err "Alias absent de $CHEMINS : $choix"; exit 1; }
    dossier=$(printf '%s' "$ligne" | cut -f2)
    ctx=$(printf '%s' "$ligne" | cut -f3)
    # 4e colonne facultative : gabarit de chat de remplacement, quand le gabarit
    # embarqué dans le GGUF ne correspond pas à ce que le modèle sait produire
    gab=$(printf '%s' "$ligne" | cut -f4)
    case "$gab" in ~/*) gab="$HOME/${gab#\~/}" ;; esac
    # le mmproj d'un modèle multimodal est un .gguf lui aussi : ne pas le servir
    attendu=$(find "$dossier" -maxdepth 1 -name "*.gguf" -size +1M ! -iname "*mmproj*" ! -name "gabarit*" | sort | head -1)
    [ -r "$PARC_SECRETS" ] && . "$PARC_SECRETS"
    servi=$(curl -s -m 3 -H "Authorization: Bearer ${CLE_LLAMACPP:-${PARC_CLE_LLAMACPP:-}}" \
      "http://127.0.0.1:${PARC_PORT_LLAMACPP:-8080}/v1/models" 2>/dev/null \
      | python3 -c 'import json,sys;print(json.load(sys.stdin)["data"][0]["id"])' 2>/dev/null)
    if [ -n "$servi" ] && [ "$(basename "${servi%.gguf}")" = "$(basename "${attendu%.gguf}")" ]; then
      printf '%sModèle déjà servi par llama.cpp.%s\n' "$c_v" "$c_0"
    else
      GABARIT="$gab" "$PARC_BIN/llamacpp-serveur" "$dossier" "$ctx" || exit 1
    fi
    printf '\n%s→ kimi -m %s%s\n\n' "$c_t" "$choix" "$c_0"
    exec "$KIMI" "${AUTO[@]}" -m "$choix" "$@"
    ;;
  *)
    err "Alias hors moteurs directs : $choix (attendu : acvram-*, vllm-*, rapide-*, llamacpp-*, tabby-*, yals-*)"
    exit 1
    ;;
esac
