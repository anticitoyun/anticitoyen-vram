#!/usr/bin/env bash
# openwebui-medias — installe dans Open WebUI (port 3000) les médias ComfyUI du parc (pièce 53j-b, 27/09) :
#   1. la Pipe « ComfyUI médias » (share/openwebui/comfyui_medias.py) : Flux.2 Klein 9B, DreamShaper 8, SD 1.5 et
#      Wan 2.2 (vidéo) comme modèles du sélecteur ;
#   2. le réglage Images natif (bouton « générer une image » d'une conversation) : Flux.2 Klein 9B,
#      share/openwebui/flux2-klein-9b.api.json et sa table de nœuds.
# Sauvegarde AVANT tout changement : config Images et Pipe en place → $OWUI/sauvegardes/medias-<date>/.
#   openwebui-medias [--a-sec]      --a-sec : affiche ce qui changerait, n'écrit rien
# Jeton : administrateur de la base, signé par ~/.webui_secret_key (la clé que « openwebui start » fait lire).
set -euo pipefail
# Racine d'OWUI : celle du lanceur « openwebui » (BASE=…), sauf OWUI=<dossier> posé.
OWUI=${OWUI:-$(sed -n 's/^BASE=//p' "$(command -v openwebui 2>/dev/null || echo /dev/null)" | head -1)}
[ -x "${OWUI:-/nonexistent}/venv/bin/python" ] || { echo "openwebui-medias : Open WebUI introuvable (lanceur openwebui, ou OWUI=<dossier>)" >&2; exit 1; }
ICI=$(cd "$(dirname "$(readlink -f "$0")")" && pwd)
PARTAGE=${PARTAGE_OWUI:-$ICI/../share/openwebui}
[ -f "$PARTAGE/comfyui_medias.py" ] || PARTAGE=/usr/share/acvram-parc/openwebui
A_SEC=0; [ "${1:-}" = --a-sec ] && A_SEC=1
curl -s -m 3 -o /dev/null http://127.0.0.1:3000/health || { echo "openwebui-medias : Open WebUI arrêté (openwebui start)" >&2; exit 1; }
SAUVE="$OWUI/sauvegardes/medias-$(date +%Y%m%d-%H%M%S)"
[ "$A_SEC" = 1 ] || mkdir -p "$SAUVE"
exec "$OWUI/venv/bin/python" - "$PARTAGE" "$SAUVE" "$A_SEC" "$OWUI" <<'PY'
import json, os, sqlite3, sys, urllib.request
import jwt
partage, sauve, a_sec, owui = sys.argv[1], sys.argv[2], sys.argv[3] == "1", sys.argv[4]
uid = sqlite3.connect(f"file:{owui}/data/webui.db?mode=ro", uri=True).execute(
    "select id from user where role='admin' order by created_at limit 1").fetchone()[0]
jeton = jwt.encode({"id": uid}, open(os.path.expanduser("~/.webui_secret_key")).read().strip(), algorithm="HS256")

def api(chemin, corps=None):
    req = urllib.request.Request("http://127.0.0.1:3000/api/v1" + chemin, method="POST" if corps is not None else "GET",
                                 data=json.dumps(corps).encode() if corps is not None else None,
                                 headers={"Authorization": "Bearer " + jeton, "Content-Type": "application/json"})
    try:
        with urllib.request.urlopen(req, timeout=60) as r:
            return json.loads(r.read() or b"null")
    except urllib.error.HTTPError as e:
        if e.code == 404 or (e.code == 401 and "/functions/id/" in chemin):
            return None
        raise SystemExit(f"openwebui-medias : {chemin} → {e.code} {e.read()[:300]!r}")

def garder(nom, obj):
    if not a_sec:
        with open(os.path.join(sauve, nom), "w") as f:
            json.dump(obj, f, ensure_ascii=False, indent=1)

# 1. Pipe
FID = "comfyui_medias"
contenu = open(os.path.join(partage, "comfyui_medias.py")).read()
avant = api(f"/functions/id/{FID}")
garder("pipe-avant.json", avant)
form = {"id": FID, "name": "ComfyUI médias", "content": contenu,
        "meta": {"description": "Images (Flux.2 Klein 9B, DreamShaper 8, SD 1.5) et vidéo (Wan 2.2) par ComfyUI"}}
if avant and avant.get("content") == contenu and avant.get("is_active"):
    print("pipe : déjà à jour et active")
elif a_sec:
    print("pipe :", "mise à jour" if avant else "création", "+ activation")
else:
    api(f"/functions/id/{FID}/update" if avant else "/functions/create", form)
    if not (api(f"/functions/id/{FID}") or {}).get("is_active"):
        api(f"/functions/id/{FID}/toggle", {})
    f = api(f"/functions/id/{FID}")
    assert f and f["is_active"] and f["content"] == contenu, "pipe non installée"
    print("pipe : installée et active")

# 2. Réglage Images natif : Flux.2 Klein 9B
conf = api("/images/config")
garder("images-config-avant.json", conf)
wf = json.load(open(os.path.join(partage, "flux2-klein-9b.api.json")))
voulu = {**conf, "ENABLE_IMAGE_GENERATION": True, "IMAGE_GENERATION_ENGINE": "comfyui",
         "IMAGE_GENERATION_MODEL": wf["70"]["inputs"]["unet_name"], "IMAGE_SIZE": "1024x1024", "IMAGE_STEPS": 4,
         "COMFYUI_BASE_URL": "http://127.0.0.1:8188", "COMFYUI_WORKFLOW": json.dumps(wf, ensure_ascii=False, indent=1),
         "COMFYUI_WORKFLOW_NODES": json.load(open(os.path.join(partage, "flux2-klein-9b.noeuds.json")))}
change = sorted(k for k in voulu if voulu[k] != conf.get(k))
print("images : " + (", ".join(change) if change else "déjà à jour"))
if change and not a_sec:
    api("/images/config/update", voulu)
    apres = api("/images/config")
    ecarts = [k for k in voulu if apres.get(k) != voulu[k]]
    assert not ecarts, f"réglage non pris : {ecarts}"
    print("images : Flux.2 Klein 9B au défaut")
print("sauvegarde :", "aucune (à sec)" if a_sec else sauve)
PY
